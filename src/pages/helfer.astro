---
import Base from '../layouts/Base.astro';
import { getTable, SUPABASE_URL, SUPABASE_KEY, SUPABASE_SCHEMA } from '../lib/content.js';

// Helferseite. Die Daten kommen LIVE beim Aufruf aus der Festival-App
// (Datenbankfunktionen helfer_portal_laden usw.), nicht beim Build.
// Gepflegt wird alles in der App unter „Helfer & Schichten“.
const einstellungen = await getTable('einstellungen', { single: true });
const jahre = await getTable('rueckblick_jahre', { order: 'reihenfolge.desc' });
const aktiv = SUPABASE_SCHEMA === 'web';
// Mails verschickt die Festival-App über ihren Server (Netlify-Funktion mail-senden)
const APP_URL = (import.meta.env.PUBLIC_APP_URL || 'https://rock4aid.netlify.app').replace(/\/+$/, '');
const BILD = '/assets/rb26-1.jpg';
const WUENSCHE = ['Bar und Getränke', 'Essen', 'Einlass und Spendenkasse', 'Aufbau', 'Abbau', 'Kuchentheke', 'Da, wo ihr mich braucht'];
---
<Base active="helfer" einstellungen={einstellungen} jahre={jahre} title="Helfer werden – Rock4Aid"
  description="Werde Teil der Rock4Aid-Crew: Registriere dich als Helferin oder Helfer für das Benefiz-Festival in Heddesheim.">
  <section class="hf-hero">
    <img class="r4a-anim" src={BILD} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;animation:r4aPan 30s ease-in-out infinite" />
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(18,10,32,.55) 0%,rgba(18,10,32,.4) 35%,rgba(30,16,58,.7) 100%)"></div>
    <div class="hf-kopf">
      <h1 class="hf-h1">Werde Teil der Rock4Aid-Crew</h1>
      <div class="hf-linie"></div>
      <p class="hf-intro" id="hf-intro">Ohne Helferinnen und Helfer gibt es kein Festival. Trag dich ein, und wir melden uns bei dir, sobald die Schichten stehen.</p>
      <p class="hf-meta" id="hf-meta" hidden></p>
    </div>

    <div class="hf-glas" id="hf-app" data-url={SUPABASE_URL} data-key={SUPABASE_KEY} data-aktiv={aktiv ? '1' : ''} data-app={APP_URL}>
      <p class="hf-laden" id="hf-laden">Einen Moment, die Helferseite wird geladen …</p>

      <!-- Meldungen (Erfolg, Fehler) -->
      <div id="hf-meldung" class="hf-meldung" role="status" hidden></div>

      <!-- Auswahl der Veranstaltung, nur wenn mehrere freigeschaltet sind -->
      <div id="hf-veranstaltungen" class="hf-veranstaltungen" hidden>
        <p class="hf-veranstaltungen-frage">Für welche Veranstaltung möchtest du helfen?</p>
        <div id="hf-veranstaltungen-liste" class="hf-veranstaltungen-liste"></div>
      </div>

      <!-- Reiter, nur wenn Schichten freigeschaltet sind -->
      <div id="hf-reiter" class="hf-reiter" role="tablist" hidden>
        <button type="button" data-reiter="schichten" class="aktiv">Schichten auswählen</button>
        <button type="button" data-reiter="pool">Allgemein registrieren</button>
        <button type="button" data-reiter="kuchen" hidden>Kuchen spenden</button>
      </div>

      <!-- Schichten -->
      <div id="hf-schichten" data-bereich="schichten" hidden>
        <p class="hf-text">Wähle einen oder mehrere Einsätze, gern auch in verschiedenen Schichten. Danach meldest du dich einmal für alles an und bekommst eine Bestätigung. Wir zeigen nur, wie viele Plätze belegt sind, keine Namen.</p>
        <div id="hf-schichtwahl" class="hf-schichtwahl"></div>
        <div id="hf-dienste" class="hf-dienste"></div>
        <div id="hf-leiste" class="hf-leiste" hidden>
          <span id="hf-leiste-text"></span>
          <button type="button" class="hf-knopf" id="hf-weiter">Weiter zur Anmeldung</button>
        </div>
      </div>

      <!-- Helferpool -->
      <form id="hf-pool" class="hf-form" data-bereich="pool" novalidate hidden>
        <p class="hf-text" id="hf-pool-text">Die Schichten planen wir einige Wochen vor dem Festival. Registriere dich schon jetzt. Sobald die Schichten stehen, schreiben wir dir und du suchst dir deine Schicht aus.</p>
        <fieldset>
          <legend>Wer bist du?</legend>
          <div class="hf-grid">
            <label class="hf-feld hf-breit">Vor- und Nachname<input name="name" autocomplete="name" required /></label>
            <label class="hf-feld">E-Mail<input name="email" type="email" autocomplete="email" required /></label>
            <label class="hf-feld">Handynummer<input name="telefon" type="tel" autocomplete="tel" required /></label>
          </div>
        </fieldset>
        <fieldset>
          <legend>Wo hilfst du am liebsten? (freiwillig)</legend>
          <div class="hf-chips">
            {WUENSCHE.map((w) => <label class="hf-chip"><input type="checkbox" name="wunsch" value={w} /> {w}</label>)}
          </div>
          <label class="hf-feld" style="margin-top:14px">Möchtest du uns noch etwas sagen? (freiwillig)<textarea name="anmerkung" rows="3" placeholder="z. B. nur nachmittags, mit Freundin zusammen, Erfahrung an der Bar"></textarea></label>
        </fieldset>
        <div class="hf-einwilligung">
          <label><input type="checkbox" name="kontakt" /> <span><strong>Ihr dürft mich kontaktieren</strong>, um meinen Einsatz beim Festival zu organisieren (per E-Mail und Telefon).</span></label>
          <label><input type="checkbox" name="kuenftig" /> <span>Ihr dürft mich auch für <strong>künftige Rock4Aid-Veranstaltungen</strong> als Helfer ansprechen. (freiwillig)</span></label>
        </div>
        <p class="hf-klein">Deine Angaben sehen nur die Organisatoren von Rock4Aid. Du kannst dich jederzeit über den Link in der Bestätigungsmail wieder austragen. Mehr dazu in unserer <a href="/datenschutz/">Datenschutzerklärung</a>.</p>
        <p class="hf-fehler" role="alert" hidden></p>
        <button type="submit" class="hf-knopf">Als Helfer registrieren</button>
      </form>

      <!-- Kuchen -->
      <div id="hf-kuchen" data-bereich="kuchen" hidden>
        <p class="hf-text" id="hf-kuchen-text">Selbstgebackener Kuchen ist bei uns heiß begehrt. Der Erlös geht vollständig an unser Spendenprojekt.</p>
        <div id="hf-kuchenliste" class="hf-kuchenliste" hidden></div>
        <p class="hf-text">Du hilfst auch in einer Schicht? Dann wähl zuerst deine Schichten aus und trag den Kuchen bei der Anmeldung einfach mit ein. So bekommst du nur eine Bestätigung.</p>
        <button type="button" class="hf-knopf" id="hf-kuchen-knopf">Kuchen eintragen</button>
      </div>

      <!-- Austragen -->
      <div id="hf-storno" hidden></div>
    </div>
  </section>

  <!-- Anmeldung: alle gewählten Einsätze und optional ein Kuchen, eine Bestätigung -->
  <dialog id="hf-dialog" class="hf-dialog">
    <form id="hf-anmeldeform" class="hf-form" method="dialog" novalidate>
      <h2 id="hf-dialog-titel">Deine Anmeldung</h2>
      <ul id="hf-auswahl" class="hf-auswahl"></ul>
      <label class="hf-feld" id="hf-kuchen-feld">Bringst du auch einen Kuchen mit? (freiwillig)<input name="kuchen" placeholder="z. B. Käsekuchen" /></label>
      <label class="hf-feld">Vor- und Nachname<input name="name" autocomplete="name" required /></label>
      <label class="hf-feld">E-Mail<input name="email" type="email" autocomplete="email" required /></label>
      <label class="hf-feld" id="hf-telefon-feld">Handynummer<input name="telefon" type="tel" autocomplete="tel" /></label>
      <div class="hf-einwilligung">
        <label><input type="checkbox" name="kontakt" /> <span><strong>Ihr dürft mich kontaktieren</strong>, um meinen Einsatz zu organisieren (per E-Mail und Telefon).</span></label>
        <label><input type="checkbox" name="kuenftig" /> <span>Ihr dürft mich auch für <strong>künftige Rock4Aid-Veranstaltungen</strong> ansprechen. (freiwillig)</span></label>
      </div>
      <p class="hf-fehler" role="alert" hidden></p>
      <div class="hf-dialog-knoepfe">
        <button type="button" class="hf-link" id="hf-abbrechen">Zurück</button>
        <button type="submit" class="hf-knopf">Verbindlich eintragen</button>
      </div>
    </form>
  </dialog>

  <style is:global>
    /* global, weil die Schichtkarten erst im Browser entstehen. Alle Klassen beginnen mit hf- */
    .hf-hero { position:relative; background:#2e1a52; overflow:hidden; padding-bottom:clamp(36px,6vw,90px); min-height:70vh; }
    .hf-kopf { position:relative; max-width:1500px; margin:0 auto; padding:clamp(28px,4vw,52px) 5.66% clamp(30px,4.4vw,56px); }
    .hf-h1 { margin:0; text-align:center; font-family:'Archivo',sans-serif; font-weight:700; font-size:clamp(28px,4.4vw,48px); line-height:1.05; letter-spacing:-.013em; color:#fff; text-wrap:balance; }
    .hf-linie { width:100%; height:2px; background:rgba(255,255,255,.9); margin:clamp(12px,1.8vw,22px) 0 0; }
    .hf-intro { max-width:760px; margin:clamp(16px,2.4vw,28px) auto 0; font-size:clamp(17px,1.8vw,21px); line-height:1.55; color:#fff; text-align:center; text-wrap:pretty; white-space:pre-line; }
    .hf-meta { margin:14px auto 0; text-align:center; color:#ffdd00; font-weight:700; font-size:clamp(16px,1.6vw,19px); display:flex; gap:6px 22px; justify-content:center; flex-wrap:wrap; }
    .hf-meta[hidden] { display:none; }
    .hf-glas { position:relative; box-sizing:border-box; width:min(820px, calc(100% - 32px)); margin:0 auto; background:rgba(255,255,255,.84); -webkit-backdrop-filter:blur(10px) saturate(1.1); backdrop-filter:blur(10px) saturate(1.1); border-radius:18px; padding:clamp(18px,3vw,34px); box-shadow:0 18px 50px rgba(10,5,25,.35); color:#4b2e83; font-family:'Archivo',sans-serif; }
    .hf-laden { text-align:center; margin:10px 0; }
    .hf-text { margin:0 0 16px; font-size:17px; line-height:1.55; }
    .hf-klein { margin:0; font-size:14px; line-height:1.5; color:#5b4a7d; }
    .hf-klein a { color:#4b2e83; font-weight:600; text-decoration:underline; }
    .hf-glas [hidden], .hf-dialog [hidden] { display:none !important; }
    .hf-reiter { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:20px; }
    .hf-reiter button { flex:1 1 180px; padding:12px 14px; border:2px solid #4b2e83; background:rgba(255,255,255,.7); color:#4b2e83; border-radius:999px; font:inherit; font-weight:700; font-size:15px; cursor:pointer; }
    .hf-reiter button.aktiv { background:#4b2e83; color:#fff; }
    .hf-form { display:flex; flex-direction:column; gap:18px; }
    .hf-form fieldset { border:2px solid #4b2e83; border-radius:10px; padding:16px clamp(14px,2.4vw,24px) 20px; margin:0; background:rgba(255,255,255,.55); }
    .hf-form legend { font-weight:700; font-size:clamp(17px,1.8vw,20px); padding:0 8px; }
    .hf-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px 18px; }
    .hf-breit { grid-column:1 / -1; }
    .hf-feld { display:flex; flex-direction:column; gap:6px; font-weight:600; font-size:15px; }
    .hf-feld input, .hf-feld textarea { padding:12px 14px; border:1.5px solid #b9acd3; border-radius:8px; font:inherit; font-weight:400; font-size:16px; color:#2a1a4a; background:rgba(255,255,255,.95); resize:vertical; }
    .hf-feld input:focus, .hf-feld textarea:focus { outline:2px solid #ffdd00; border-color:#4b2e83; }
    .hf-chips { display:flex; flex-wrap:wrap; gap:8px; }
    .hf-chip { display:inline-flex; align-items:center; gap:6px; padding:9px 14px; border:1.5px solid #b9acd3; border-radius:999px; font-weight:600; font-size:15px; cursor:pointer; background:rgba(255,255,255,.7); }
    .hf-chip input { accent-color:#4b2e83; margin:0; }
    .hf-chip:has(input:checked) { background:#4b2e83; border-color:#4b2e83; color:#fff; }
    .hf-einwilligung { display:flex; flex-direction:column; gap:10px; }
    .hf-einwilligung label { display:flex; gap:10px; align-items:flex-start; font-size:15px; line-height:1.45; cursor:pointer; }
    .hf-einwilligung input { width:20px; height:20px; margin:1px 0 0; flex:0 0 auto; accent-color:#4b2e83; }
    .hf-einwilligung label.hf-pflicht-fehlt { color:#a12020; }
    .hf-fehler { background:#fde8e8; color:#a12020; border-radius:8px; padding:12px 14px; font-weight:600; margin:0; }
    .hf-knopf { background:#4b2e83; color:#fff; border:0; border-radius:999px; padding:15px 28px; font:inherit; font-weight:700; font-size:17px; cursor:pointer; align-self:center; }
    .hf-knopf:hover { background:#3d2569; }
    .hf-knopf:disabled { opacity:.6; cursor:wait; }
    .hf-knopf.rot { background:#b3261e; }
    .hf-link { background:none; border:0; color:#4b2e83; font:inherit; font-weight:600; text-decoration:underline; cursor:pointer; padding:8px; }
    .hf-meldung { background:#ffdd00; color:#4b2e83; border-radius:12px; padding:18px 20px; margin-bottom:20px; font-size:17px; line-height:1.5; }
    .hf-meldung p { margin:.2em 0; }
    .hf-veranstaltungen { margin-bottom:16px; }
    .hf-veranstaltungen-frage { font-weight:800; color:#4b2e83; margin:0 0 8px; }
    .hf-veranstaltungen-liste { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:8px; }
    .hf-veranstaltung { display:flex; flex-direction:column; align-items:flex-start; gap:2px; padding:10px 16px; border-radius:12px; border:2px solid #b9acd3; background:rgba(255,255,255,.8); color:#4b2e83; font:inherit; cursor:pointer; text-align:left; }
    .hf-veranstaltung span { font-size:13px; color:#5b4a7d; }
    .hf-veranstaltung.aktiv { border-color:#4b2e83; background:#4b2e83; color:#fff; }
    .hf-veranstaltung.aktiv span { color:#ffdd00; }
    .hf-schichtwahl { display:flex; gap:8px; overflow-x:auto; padding-bottom:6px; margin-bottom:16px; }
    .hf-schicht { flex:0 0 auto; display:flex; flex-direction:column; align-items:flex-start; gap:2px; padding:10px 16px; border-radius:12px; border:2px solid #b9acd3; background:rgba(255,255,255,.8); color:#4b2e83; font:inherit; cursor:pointer; text-align:left; }
    .hf-schicht span { font-size:13px; color:#5b4a7d; }
    .hf-schicht em { font-style:normal; font-size:12px; font-weight:700; color:#1f7a35; }
    .hf-schicht.aktiv { border-color:#4b2e83; background:#4b2e83; color:#fff; }
    .hf-schicht.aktiv span, .hf-schicht.aktiv em { color:#ffdd00; }
    .hf-dienste { display:grid; gap:14px; grid-template-columns:repeat(auto-fill, minmax(230px, 1fr)); }
    .hf-dienst { background:rgba(255,255,255,.85); border:2px solid #d8cfe8; border-radius:12px; padding:14px 16px; display:flex; flex-direction:column; gap:10px; }
    .hf-dienst h3 { margin:0; font-size:18px; display:flex; gap:8px; align-items:center; }
    .hf-dienst p { margin:0; font-size:14px; color:#5b4a7d; }
    .hf-balken { height:8px; border-radius:99px; background:#e6e0f0; overflow:hidden; }
    .hf-balken > div { height:100%; background:#4b2e83; border-radius:99px; }
    .hf-belegt { font-size:14px; font-weight:600; }
    .hf-dienst .hf-knopf { padding:10px 18px; font-size:15px; align-self:flex-start; }
    .hf-dienst.voll { opacity:.6; }
    .hf-leiste { position:sticky; bottom:12px; z-index:5; margin-top:18px; background:#2e1a52; color:#fff; border-radius:14px; padding:12px 16px; display:flex; gap:12px; align-items:center; justify-content:space-between; flex-wrap:wrap; box-shadow:0 10px 26px rgba(10,5,25,.35); font-weight:700; }
    .hf-leiste .hf-knopf { background:#ffdd00; color:#2e1a52; padding:11px 22px; font-size:16px; }
    .hf-dienst.gewaehlt { border-color:#4b2e83; box-shadow:0 0 0 2px #4b2e83; }
    .hf-dienst .hf-knopf.an { background:#1f7a35; }
    .hf-auswahl { list-style:none; padding:0; margin:4px 0; display:flex; flex-direction:column; gap:6px; }
    .hf-auswahl li { display:flex; justify-content:space-between; align-items:center; gap:8px; background:#f1ecf8; border-radius:10px; padding:8px 12px; font-size:15px; }
    .hf-kuchenliste { background:rgba(255,255,255,.7); border-radius:10px; padding:12px 16px; font-size:15px; line-height:1.6; }
    .hf-dialog { border:0; border-radius:16px; padding:22px; width:min(440px, calc(100% - 32px)); color:#4b2e83; font-family:'Archivo',sans-serif; }
    .hf-dialog::backdrop { background:rgba(18,10,32,.6); }
    .hf-dialog h2 { margin:0; font-size:22px; }
    .hf-dialog .hf-form { gap:12px; }
    .hf-dialog-knoepfe { display:flex; justify-content:flex-end; align-items:center; gap:8px; flex-wrap:wrap; }
    .hf-storno h2 { margin:0 0 10px; }
    .hf-storno p { font-size:17px; line-height:1.5; }
    @media (max-width:640px) { .hf-h1, .hf-intro { text-align:left; } .hf-meta { justify-content:flex-start; } .hf-grid { grid-template-columns:1fr; } .hf-chip { font-size:14px; padding:8px 12px; } }
  </style>

  <script>
    (function () {
      const app = document.getElementById('hf-app');
      if (!app) return;
      const URL_ = app.dataset.url;
      const KEY = app.dataset.key;
      const SLUG = 'rock4aid';
      const HIER = location.origin + '/helfer/';
      const $ = (id) => document.getElementById(id);
      const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      const KONTAKT_FEHLT = 'Du kannst dich hier nur als Helfer registrieren, wenn wir dich kontaktieren dürfen.';
      let daten = null;
      let schichtId = null;
      // Gewählte Veranstaltung, wenn mehrere freigeschaltet sind (Link: ?veranstaltung=<id>)
      let eventId = new URLSearchParams(location.search).get('veranstaltung');

      // Aufruf einer Datenbankfunktion der Festival-App
      async function rpc(name, args) {
        const r = await fetch(`${URL_}/rest/v1/rpc/${name}`, {
          method: 'POST',
          headers: { apikey: KEY, Authorization: `Bearer ${KEY}`, 'Content-Type': 'application/json', 'Content-Profile': 'public', 'Accept-Profile': 'public' },
          body: JSON.stringify(args),
        });
        const text = await r.text();
        const json = text ? JSON.parse(text) : null;
        if (!r.ok) throw new Error((json && json.message) || 'Das hat leider nicht geklappt. Bitte versuche es gleich noch einmal.');
        return json;
      }

      // Bestätigungsmail: Text und Empfänger baut der Server der Festival-App selbst aus
      // der Datenbank. Die Seite übergibt nur den Schlüssel der Anmeldung.
      // Ein Fehler beim Mailversand verhindert die Anmeldung nicht.
      async function mail(payload) {
        try {
          const r = await fetch(`${app.dataset.app}/.netlify/functions/mail-senden`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
          });
          return r.ok;
        } catch { return false; }
      }

      function merke(k) { try { localStorage.setItem('r4a_helfer', JSON.stringify(k)); } catch { /* egal */ } }
      function gemerkt() { try { return JSON.parse(localStorage.getItem('r4a_helfer') || '{}') || {}; } catch { return {}; } }
      function vorbelegen(form, k) {
        ['name', 'email', 'telefon'].forEach((f) => { if (form.elements[f] && k[f] && !form.elements[f].value) form.elements[f].value = k[f]; });
      }

      function meldung(html) {
        const m = $('hf-meldung');
        m.innerHTML = html; m.hidden = false;
        m.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

      // Einwilligung und Pflichtfelder prüfen. Liefert einen Fehlertext oder null.
      function pruefe(form, { telefon = true, kuchen = false } = {}) {
        const f = form.elements;
        const box = f.kontakt.closest('label');
        box.classList.toggle('hf-pflicht-fehlt', !f.kontakt.checked);
        if (!f.kontakt.checked) return KONTAKT_FEHLT;
        if (kuchen && !f.kuchen.value.trim()) return 'Welchen Kuchen bringst du mit?';
        if (!f.name.value.trim()) return 'Bitte gib deinen Namen an.';
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(f.email.value.trim())) return 'Bitte gib eine gültige E-Mail-Adresse an.';
        if (telefon && !f.telefon.value.trim()) return 'Bitte gib deine Handynummer an, damit wir dich am Festivaltag erreichen.';
        return null;
      }
      function fehler(form, text) {
        const p = form.querySelector('.hf-fehler');
        p.textContent = text || ''; p.hidden = !text;
        if (text) p.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      // ---------- Reiter ----------
      function zeige(bereich) {
        document.querySelectorAll('[data-reiter]').forEach((b) => b.classList.toggle('aktiv', b.dataset.reiter === bereich));
        document.querySelectorAll('[data-bereich]').forEach((el) => { el.hidden = el.dataset.bereich !== bereich; });
      }
      document.querySelectorAll('[data-reiter]').forEach((b) => b.addEventListener('click', () => zeige(b.dataset.reiter)));

      // ---------- Schichten: Einsätze auswählen ----------
      let auswahl = []; // [{ schicht, dienst }]
      function platz(sId, dId) {
        return (daten.plaetze || []).find((p) => p.schicht_id === sId && p.dienst_id === dId);
      }
      const gewaehlt = (sId, dId) => auswahl.some((x) => x.schicht === sId && x.dienst === dId);
      function umschalten(sId, dId) {
        auswahl = gewaehlt(sId, dId) ? auswahl.filter((x) => !(x.schicht === sId && x.dienst === dId)) : [...auswahl, { schicht: sId, dienst: dId }];
        zeichneSchichten();
      }
      function beschreibe(x) {
        const s = daten.schichten.find((y) => y.id === x.schicht) || {};
        const d = daten.dienste.find((y) => y.id === x.dienst) || {};
        return { schicht: s.bezeichnung, zeit: s.zeit_text, dienst: d.bezeichnung, icon: d.icon };
      }
      function zeichneSchichten() {
        const wahl = $('hf-schichtwahl');
        wahl.innerHTML = '';
        (daten.schichten || []).forEach((s) => {
          const frei = (daten.plaetze || []).filter((p) => p.schicht_id === s.id).reduce((x, p) => x + Math.max(0, p.anzahl - p.belegt), 0);
          const n = auswahl.filter((x) => x.schicht === s.id).length;
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'hf-schicht' + (s.id === schichtId ? ' aktiv' : '');
          b.innerHTML = `<strong>${esc(s.bezeichnung)}${n ? ` ✓${n}` : ''}</strong>${s.zeit_text ? `<span>${esc(s.zeit_text)}</span>` : ''}<em>${frei > 0 ? `${frei} ${frei === 1 ? 'Platz' : 'Plätze'} frei` : 'voll besetzt'}</em>`;
          b.addEventListener('click', () => { schichtId = s.id; zeichneSchichten(); });
          wahl.appendChild(b);
        });
        const box = $('hf-dienste');
        box.innerHTML = '';
        const dienste = (daten.dienste || []).filter((d) => platz(schichtId, d.id));
        if (!dienste.length) box.innerHTML = '<p class="hf-text">In dieser Schicht sind keine Dienste geplant.</p>';
        dienste.forEach((d) => {
          const p = platz(schichtId, d.id);
          const voll = p.belegt >= p.anzahl;
          const an = gewaehlt(schichtId, d.id);
          const karte = document.createElement('div');
          karte.className = 'hf-dienst' + (voll ? ' voll' : '') + (an ? ' gewaehlt' : '');
          karte.innerHTML = `<h3><span>${esc(d.icon || '⭐')}</span>${esc(d.bezeichnung)}</h3>
            ${d.beschreibung ? `<p>${esc(d.beschreibung)}</p>` : ''}
            <div class="hf-balken"><div style="width:${Math.min(100, Math.round((p.belegt / p.anzahl) * 100))}%"></div></div>
            <span class="hf-belegt">${p.belegt} von ${p.anzahl} Plätzen belegt</span>
            ${voll ? '' : `<button type="button" class="hf-knopf${an ? ' an' : ''}">${an ? '✓ Ausgewählt' : 'Auswählen'}</button>`}`;
          const k = karte.querySelector('button');
          if (k) k.addEventListener('click', () => umschalten(schichtId, d.id));
          box.appendChild(karte);
        });
        $('hf-leiste').hidden = !auswahl.length;
        $('hf-leiste-text').textContent = `${auswahl.length} ${auswahl.length === 1 ? 'Einsatz' : 'Einsätze'} ausgewählt`;
      }

      // ---------- Anmeldung: ein Formular, eine Bestätigung ----------
      const dialog = $('hf-dialog');
      const aform = $('hf-anmeldeform');
      let nurKuchen = false;
      function zeichneAuswahl() {
        const ul = $('hf-auswahl');
        ul.innerHTML = '';
        auswahl.forEach((x) => {
          const b = beschreibe(x);
          const li = document.createElement('li');
          li.innerHTML = `<span>${esc(b.icon || '⭐')} <strong>${esc(b.dienst)}</strong> · ${esc([b.schicht, b.zeit].filter(Boolean).join(', '))}</span><button type="button" class="hf-link" aria-label="Entfernen">✕</button>`;
          li.querySelector('button').addEventListener('click', () => { umschalten(x.schicht, x.dienst); if (!auswahl.length && !nurKuchen) dialog.close(); else zeichneAuswahl(); });
          ul.appendChild(li);
        });
        ul.hidden = !auswahl.length;
        const mitSchicht = auswahl.length > 0;
        $('hf-dialog-titel').textContent = mitSchicht ? 'Deine Anmeldung' : '🎂 Kuchen eintragen';
        $('hf-telefon-feld').hidden = !mitSchicht;
        const kuchenAn = !!(daten.einstellungen || {}).kuchen_aktiv;
        $('hf-kuchen-feld').hidden = !kuchenAn;
        $('hf-kuchen-feld').firstChild.textContent = mitSchicht ? 'Bringst du auch einen Kuchen mit? (freiwillig)' : 'Welchen Kuchen bringst du mit?';
      }
      function oeffneDialog(kuchen) {
        nurKuchen = !!kuchen;
        zeichneAuswahl();
        fehler(aform, null);
        vorbelegen(aform, gemerkt());
        if (dialog.showModal) dialog.showModal(); else dialog.setAttribute('open', '');
      }
      $('hf-weiter').addEventListener('click', () => oeffneDialog(false));
      $('hf-kuchen-knopf').addEventListener('click', () => oeffneDialog(true));
      $('hf-abbrechen').addEventListener('click', () => dialog.close());
      aform.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const f = aform.elements;
        const mitSchicht = auswahl.length > 0;
        const kuchen = f.kuchen.value.trim();
        let t = pruefe(aform, { telefon: mitSchicht });
        if (!t && !mitSchicht && !kuchen) t = 'Welchen Kuchen bringst du mit?';
        if (t) return fehler(aform, t);
        fehler(aform, null);
        const knopf = aform.querySelector('button[type=submit]');
        knopf.disabled = true;
        try {
          const k = { name: f.name.value.trim(), email: f.email.value.trim(), telefon: f.telefon.value.trim() };
          const r = await rpc('helfer_anmelden', {
            p_slug: SLUG, p_name: k.name, p_email: k.email, p_telefon: mitSchicht ? k.telefon : '',
            p_einsaetze: auswahl, p_kuchen: kuchen, p_kontakt: true, p_kuenftig: f.kuenftig.checked,
            ...(daten.event_id ? { p_event_id: daten.event_id } : {}),
          });
          merke({ ...gemerkt(), ...k });
          const vorname = k.name.split(/\s+/)[0];
          const ok = await mail({ art: 'helfer_bestaetigung', token: r.token });
          const teile = [];
          if (mitSchicht) teile.push(`${auswahl.length} ${auswahl.length === 1 ? 'Einsatz' : 'Einsätze'}`);
          if (kuchen) teile.push('dein Kuchen');
          auswahl = [];
          aform.reset();
          dialog.close();
          meldung(`<p><strong>Danke, ${esc(vorname)}!</strong> Eingetragen: ${esc(teile.join(' und '))}.</p>
            <p>${ok ? 'Eine Bestätigung mit allen Zusagen und einem Link zum Austragen kommt per E-Mail.' : ok === false ? 'Die Bestätigungsmail konnte leider nicht verschickt werden. Deine Anmeldung ist trotzdem gespeichert.' : ''}</p>`);
          await laden();
        } catch (x) { fehler(aform, x.message); }
        finally { knopf.disabled = false; }
      });

      // ---------- Helferpool ----------
      const pform = $('hf-pool');
      pform.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const t = pruefe(pform);
        if (t) return fehler(pform, t);
        fehler(pform, null);
        const f = pform.elements;
        const knopf = pform.querySelector('button[type=submit]');
        knopf.disabled = true;
        try {
          const k = { name: f.name.value.trim(), email: f.email.value.trim(), telefon: f.telefon.value.trim() };
          const wunsch = [...pform.querySelectorAll('input[name=wunsch]:checked')].map((x) => x.value).join(', ');
          const r = (await rpc('helfer_pool_eintragen', {
            p_slug: SLUG, p_name: k.name, p_email: k.email, p_telefon: k.telefon, p_wunsch: wunsch,
            p_anmerkung: f.anmerkung.value.trim(), p_kontakt: true, p_kuenftig: f.kuenftig.checked,
          }))[0];
          merke(k);
          const vorname = k.name.split(/\s+/)[0];
          // Keine Zeile zurück = E-Mail ist schon im Pool. Aus Datenschutzgründen antworten wir neutral.
          const ok = !r ? null : await mail({ art: 'pool_bestaetigung', id: r.id, token: r.cancel_token });
          pform.reset();
          pform.hidden = true;
          $('hf-reiter').hidden = true;
          meldung(`<p><strong>Danke, ${esc(vorname)}! Du bist als Helfer registriert.</strong></p>
            <p>Sobald die Schichten stehen, melden wir uns bei dir. ${ok ? 'Eine Bestätigung kommt per E-Mail.' : ''}</p>`);
        } catch (x) { fehler(pform, x.message); }
        finally { knopf.disabled = false; }
      });

      // ---------- Austragen über den Link aus der Mail ----------
      async function storno(art, id, token) {
        const box = $('hf-storno');
        box.className = 'hf-storno'; box.hidden = false;
        if (art === 'alle') return stornoAlle(token);
        let eintrag = null;
        try { eintrag = await rpc('helfer_eintrag_ansehen', { p_art: art, p_id: id, p_token: token }); } catch { /* ungültig */ }
        const zurueck = '<p><a class="hf-link" href="/helfer/">Zur Helferseite</a></p>';
        if (!eintrag) { box.innerHTML = `<h2>Eintrag nicht gefunden</h2><p>Der Link ist ungültig, oder du hast dich bereits ausgetragen.</p>${zurueck}`; return; }
        const was = art === 'helfer' ? `deine Schicht <strong>${esc(eintrag.dienst)}</strong> (${esc([eintrag.schicht, eintrag.zeit].filter(Boolean).join(', '))})`
          : art === 'kuchen' ? `deine Kuchenspende <strong>${esc(eintrag.kuchen)}</strong>`
          : 'deine Registrierung im Helferpool';
        box.innerHTML = `<h2>Wirklich austragen?</h2><p>${esc(eintrag.name)}, du möchtest ${was} zurückziehen.</p>
          <div class="hf-dialog-knoepfe"><a class="hf-link" href="/helfer/">Nein, ich bleibe dabei</a><button type="button" class="hf-knopf rot">Ja, austragen</button></div>`;
        box.querySelector('button').addEventListener('click', async (ev) => {
          ev.target.disabled = true;
          let ok = false;
          try { ok = await rpc('helfer_eintrag_stornieren', { p_art: art, p_id: id, p_token: token }); } catch { ok = false; }
          box.innerHTML = ok ? `<h2>Du bist ausgetragen</h2><p>Schade, dass es nicht klappt. Danke, dass du Bescheid gegeben hast!</p>${zurueck}`
            : `<h2>Das hat nicht geklappt</h2><p>Bitte versuche es noch einmal oder schreib uns über das <a class="hf-link" href="/kontakt/">Kontaktformular</a>.</p>`;
        });
      }

      // Alle Zusagen einer Anmeldung, einzeln oder gesammelt zurückziehen
      async function stornoAlle(token) {
        const box = $('hf-storno');
        const zurueck = '<p><a class="hf-link" href="/helfer/">Zur Helferseite</a></p>';
        let g = null;
        try { g = await rpc('helfer_gruppe_ansehen', { p_token: token }); } catch { /* ungültig */ }
        if (!g) { box.innerHTML = `<h2>Eintrag nicht gefunden</h2><p>Der Link ist ungültig, oder du hast dich bereits überall ausgetragen.</p>${zurueck}`; return; }
        const liste = [...g.einsaetze.map((x) => ['helfer', x.id, `${x.icon || '⭐'} ${x.dienst} · ${[x.schicht, x.zeit].filter(Boolean).join(', ')}`]),
          ...g.kuchen.map((x) => ['kuchen', x.id, `🎂 Kuchen: ${x.kuchen}`])];
        const weg = new Set();
        const zeichne = () => {
          const offen = liste.filter(([, i]) => !weg.has(i));
          box.innerHTML = `<h2>Deine Zusagen, ${esc(String(g.name || '').split(/\s+/)[0])}</h2><p>Du kannst einzelne Zusagen oder alle zurückziehen.</p>
            <ul class="hf-auswahl">${liste.map(([a, i, t]) => `<li><span${weg.has(i) ? ' style="text-decoration:line-through;opacity:.6"' : ''}>${esc(t)}</span>${weg.has(i) ? '<em>ausgetragen</em>' : `<button type="button" class="hf-link" data-art="${a}" data-id="${i}">Austragen</button>`}</li>`).join('')}</ul>
            ${offen.length === 0 ? '<p><strong>Du bist überall ausgetragen.</strong> Schade, dass es nicht klappt. Danke, dass du Bescheid gegeben hast!</p>' : ''}
            <div class="hf-dialog-knoepfe"><a class="hf-link" href="/helfer/">Zur Helferseite</a>${offen.length > 1 ? '<button type="button" class="hf-knopf rot" data-alle>Alle austragen</button>' : ''}</div>`;
          box.querySelectorAll('button[data-id]').forEach((b) => b.addEventListener('click', () => austragen([[b.dataset.art, b.dataset.id]])));
          const alle = box.querySelector('[data-alle]');
          if (alle) alle.addEventListener('click', () => austragen(offen.map(([a, i]) => [a, i])));
        };
        const austragen = async (paare) => {
          box.querySelectorAll('button').forEach((b) => { b.disabled = true; });
          for (const [a, i] of paare) {
            try { if (await rpc('helfer_eintrag_stornieren', { p_art: a, p_id: i, p_token: token })) weg.add(i); } catch { /* weiter */ }
          }
          zeichne();
        };
        zeichne();
      }

      // ---------- Frühere Helfer bestätigen über den Link aus der Anfrage-Mail ----------
      async function bestaetigen(id, token) {
        const box = $('hf-storno');
        box.className = 'hf-storno'; box.hidden = false;
        let k = null;
        try { k = await rpc('helfer_pool_ansehen', { p_id: id, p_token: token }); } catch { /* ungültig */ }
        const zurueck = '<p><a class="hf-link" href="/helfer/">Zur Helferseite</a></p>';
        if (!k) { box.innerHTML = `<h2>Link nicht mehr gültig</h2><p>Deine Daten wurden vielleicht schon gelöscht. Du kannst dich jederzeit neu registrieren.</p>${zurueck}`; return; }
        const vorname = esc(String(k.name || '').split(/\s+/)[0]);
        box.innerHTML = `<h2>Hallo ${vorname}, bist du wieder dabei?</h2>
          <p>Du hast uns früher schon als Helfer unterstützt. Dafür noch einmal danke! Wenn du wieder mithelfen möchtest, bestätige bitte, dass wir dich dafür kontaktieren dürfen.</p>
          <form class="hf-form" novalidate>
            <div class="hf-einwilligung">
              <label><input type="checkbox" name="kontakt" /> <span><strong>Ihr dürft mich kontaktieren</strong>, um meinen Einsatz beim Festival zu organisieren (per E-Mail und Telefon).</span></label>
              <label><input type="checkbox" name="kuenftig" /> <span>Ihr dürft mich auch für <strong>künftige Rock4Aid-Veranstaltungen</strong> als Helfer ansprechen. (freiwillig)</span></label>
            </div>
            <p class="hf-fehler" role="alert" hidden></p>
            <div class="hf-dialog-knoepfe">
              <button type="button" class="hf-link" data-nein>Nein danke, löscht meine Daten</button>
              <button type="submit" class="hf-knopf">Ja, ich bin dabei</button>
            </div>
          </form>`;
        const form = box.querySelector('form');
        form.addEventListener('submit', async (ev) => {
          ev.preventDefault();
          const f = form.elements;
          f.kontakt.closest('label').classList.toggle('hf-pflicht-fehlt', !f.kontakt.checked);
          if (!f.kontakt.checked) return fehler(form, KONTAKT_FEHLT);
          try {
            const ok = await rpc('helfer_pool_bestaetigen', { p_id: id, p_token: token, p_kontakt: true, p_kuenftig: f.kuenftig.checked });
            if (!ok) throw new Error('Der Link ist nicht mehr gültig.');
            merke({ name: k.name, email: k.email, telefon: k.telefon });
            box.innerHTML = `<h2>Schön, dass du wieder dabei bist, ${vorname}!</h2><p>Wir melden uns bei dir, sobald die Schichten stehen.</p>${zurueck}`;
          } catch (x) { fehler(form, x.message); }
        });
        box.querySelector('[data-nein]').addEventListener('click', async () => {
          let ok = false;
          try { ok = await rpc('helfer_eintrag_stornieren', { p_art: 'pool', p_id: id, p_token: token }); } catch { ok = false; }
          box.innerHTML = ok ? '<h2>Deine Daten sind gelöscht</h2><p>Danke für deine Unterstützung in der Vergangenheit!</p>'
            : `<h2>Das hat nicht geklappt</h2><p>Bitte versuche es noch einmal oder schreib uns über das <a class="hf-link" href="/kontakt/">Kontaktformular</a>.</p>`;
        });
      }

      // ---------- Laden ----------
      async function laden() {
        daten = await rpc('helfer_portal_laden', eventId ? { p_slug: SLUG, p_event_id: eventId } : { p_slug: SLUG });
        if (!daten) throw new Error('aus');
        if (daten.event_id) eventId = daten.event_id;
        zeichneVeranstaltungen();
        const e = daten.einstellungen || {};
        if (e.pool_einleitung && !daten.schichten_offen) $('hf-intro').textContent = e.pool_einleitung;
        if (daten.schichten_offen) $('hf-intro').textContent = e.einleitung || 'Die Schichten stehen! Such dir aus, wann und wo du mit anpacken möchtest.';
        const liste = daten.veranstaltungen || [];
        const aktuell = liste.length > 1 ? liste.find((v) => v.id === daten.event_id) : null;
        const meta = [aktuell && `🎸 ${aktuell.name}`, e.datum_text && `📅 ${e.datum_text}`, e.ort_text && `📍 ${e.ort_text}`].filter(Boolean);
        if (daten.schichten_offen) {
          const gesamt = (daten.plaetze || []).reduce((x, p) => x + p.anzahl, 0);
          const frei = (daten.plaetze || []).reduce((x, p) => x + Math.max(0, p.anzahl - p.belegt), 0);
          if (gesamt) meta.push(frei ? `🙌 Noch ${frei} von ${gesamt} Plätzen frei` : '🙌 Alle Plätze sind besetzt. Danke!');
        }
        $('hf-meta').innerHTML = meta.map((m) => `<span>${esc(m)}</span>`).join('');
        $('hf-meta').hidden = !meta.length;
        if (daten.schichten_offen) {
          if (!schichtId || !daten.schichten.some((s) => s.id === schichtId)) schichtId = daten.schichten[0] && daten.schichten[0].id;
          zeichneSchichten();
          const kuchen = !!e.kuchen_aktiv;
          document.querySelector('[data-reiter=kuchen]').hidden = !kuchen;
          if (e.kuchen_hinweis) $('hf-kuchen-text').textContent = e.kuchen_hinweis;
          const liste = daten.kuchen || [];
          $('hf-kuchenliste').hidden = !liste.length;
          $('hf-kuchenliste').innerHTML = liste.length ? `<strong>Schon angekündigt:</strong> ${liste.map(esc).join(', ')}` : '';
          $('hf-pool-text').textContent = 'Du weißt noch nicht, wann du Zeit hast? Registriere dich allgemein. Wir melden uns bei dir, wenn wir noch Unterstützung brauchen.';
        }
      }

      // Mehrere freigeschaltete Veranstaltungen: zuerst die Veranstaltung wählen
      function zeichneVeranstaltungen() {
        const liste = daten.veranstaltungen || [];
        const box = $('hf-veranstaltungen');
        box.hidden = liste.length < 2;
        const ziel = $('hf-veranstaltungen-liste');
        ziel.innerHTML = '';
        if (liste.length < 2) return;
        liste.forEach((v) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'hf-veranstaltung' + (v.id === daten.event_id ? ' aktiv' : '');
          b.setAttribute('aria-pressed', v.id === daten.event_id ? 'true' : 'false');
          b.innerHTML = `<strong>${esc(v.name)}</strong>${v.datum_text ? `<span>📅 ${esc(v.datum_text)}</span>` : ''}${v.ort_text ? `<span>📍 ${esc(v.ort_text)}</span>` : ''}`;
          b.addEventListener('click', async () => {
            if (v.id === daten.event_id) return;
            eventId = v.id; auswahl = []; schichtId = null;
            try { const u = new URL(location.href); u.searchParams.set('veranstaltung', v.id); history.replaceState(null, '', u); } catch { /* egal */ }
            try { await laden(); zeige('schichten'); } catch { /* bleibt bei der alten Anzeige */ }
          });
          ziel.appendChild(b);
        });
      }

      async function start() {
        const p = new URLSearchParams(location.search);
        if (!app.dataset.aktiv || !URL_ || !KEY) {
          $('hf-laden').textContent = 'Die Helferseite ist gerade nicht erreichbar. Schreib uns gern über das Kontaktformular.';
          return;
        }
        if (p.get('storno')) { $('hf-laden').hidden = true; return storno(p.get('storno'), p.get('id'), p.get('token')); }
        if (p.get('bestaetigen')) { $('hf-laden').hidden = true; return bestaetigen(p.get('bestaetigen'), p.get('token')); }
        try { await laden(); }
        catch {
          $('hf-laden').innerHTML = 'Die Helferseite ist gerade nicht erreichbar. Schreib uns gern über das <a class="hf-link" href="/kontakt/">Kontaktformular</a>.';
          return;
        }
        $('hf-laden').hidden = true;
        // Einladungslink aus dem Helferpool füllt die Daten vor
        if (p.get('pool') && p.get('token')) {
          try {
            const k = await rpc('helfer_pool_ansehen', { p_id: p.get('pool'), p_token: p.get('token') });
            if (k) { merke(k); }
          } catch { /* egal */ }
        }
        const k = gemerkt();
        vorbelegen(pform, k);
        if (daten.schichten_offen) { $('hf-reiter').hidden = false; zeige(p.get('bereich') === 'pool' ? 'pool' : 'schichten'); }
        else zeige('pool');
      }
      start();
    })();
  </script>
</Base>
