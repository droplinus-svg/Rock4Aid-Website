---
import Base from '../layouts/Base.astro';
import BandLinks from '../components/BandLinks.astro';
import { getTable } from '../lib/content.js';

export async function getStaticPaths() {
  const einstellungen = await getTable('einstellungen', { single: true });
  const alle = await getTable('rueckblick_jahre', {
    select: '*,rueckblick_intro(*),rueckblick_acts(*,links:rueckblick_act_links(*)),rueckblick_presse(*)',
    order: 'reihenfolge.desc',
  });
  const jahre = (alle || []).filter((j) => j.sichtbar !== false);
  const oeffentlich = jahre.map((j) => ({ params: { slug: j.slug }, props: { jahr: j, einstellungen, jahre, vorschau: false } }));
  // Vorschau: Jeder Rückblick ist zusätzlich unter einer geheimen Adresse erreichbar,
  // auch wenn er ausgeblendet ist. Diese Seiten stehen in keinem Menü und werden
  // von Suchmaschinen nicht aufgenommen (sql/62, Spalte vorschau_token).
  const vorschauSeiten = (alle || []).filter((j) => j.vorschau_token)
    .map((j) => ({ params: { slug: `vorschau-${j.vorschau_token}` }, props: { jahr: j, einstellungen, jahre, vorschau: true } }));
  return [...oeffentlich, ...vorschauSeiten];
}

const { jahr, einstellungen, jahre, vorschau } = Astro.props;
const byR = (a, b) => (a.reihenfolge ?? 0) - (b.reihenfolge ?? 0);
const intro = [...(jahr.rueckblick_intro || [])].sort(byR);
const acts = [...(jahr.rueckblick_acts || [])].sort(byR);
const presse = [...(jahr.rueckblick_presse || [])].sort(byR);
const isVideo = (s) => /\.(mp4|webm|mov|m4v)$/i.test(s || '');
// Leere Absätze entfernen. Zweimal Enter im Editor erzeugt einen leeren Absatz,
// der zusammen mit dem Absatzabstand eine viel zu große Lücke ergibt.
const ohneLeer = (html) => String(html || '')
  .replace(/<(p|div)\b[^>]*>(?:\s|&nbsp;|<br\s*\/?>)*<\/\1>/gi, '')
  .replace(/(?:<br\s*\/?>\s*){2,}/gi, '<br>');
const fliesstext = ohneLeer(jahr.fliesstext);
const kennzahlen = ohneLeer(jahr.kennzahlen);
// Intro-Bilder ohne Lücken anordnen: Vielfache von drei in Dreierreihen, sonst
// zu zweit. Bleibt bei zwei Spalten ein Bild übrig, nutzt es die ganze Breite.
const introSpalten = intro.length % 3 === 0 ? 3 : 2;
const introBreit = (i) => introSpalten === 2 && intro.length % 2 === 1 && i === intro.length - 1;

// 2025-Stil: Text links, gerahmte Urkunde rechts (genau EIN gerahmtes Intro-Bild)
const urkundeMode = intro.length === 1 && intro[0].rahmen;
// 2026-Stil: versetzte Presse-Collage (Original). 2027+ nutzt das Raster.
const collageMode = Number(jahr.jahr) === 2026 && (jahr.veranstaltung || 'Festival') === 'Festival';
const COLLAGE = [
  ['presse26-4', 0.72, 0, 16.36], ['presse26-1', 43.35, 0, 53.68],
  ['presse26-3', 8.9, 11.61, 33.54], ['presse26-2', 43.35, 24.04, 54.09],
  ['presse26-6', 0, 55.19, 32], ['presse26-7', 34.05, 55.19, 32],
  ['presse26-5', 67.99, 55.19, 32], ['presse26-8', 4.5, 76.86, 22.9],
];
const findImg = (m) => presse.find((p) => (p.bild || '').includes(m));
const collageItems = COLLAGE.map(([m, l, t, w]) => ({ p: findImg(m), l, t, w })).filter((x) => x.p);
---
<Base active="rueckblick" activeSlug={jahr.slug} einstellungen={einstellungen} jahre={jahre} title={`${vorschau ? 'Vorschau: ' : ''}${jahr.titel} – Rock4Aid`} noindex={vorschau}>
  {vorschau && (
    <div style="background:#e5007d;color:#fff;font-family:'Archivo',sans-serif;font-weight:700;font-size:15px;line-height:1.4;padding:10px clamp(18px,5.66vw,85px);text-align:center">
      {jahr.sichtbar === false
        ? 'Vorschau. Diese Seite ist noch nicht öffentlich und steht in keinem Menü.'
        : `Vorschau. Diese Seite ist öffentlich unter rock4aid.de/${jahr.slug}.`}
    </div>
  )}
  <section id="rueckblick" style="background:#4b2e83;padding:clamp(34px,5.2vw,53px) 0 clamp(40px,5vw,52px)">
    <div style="max-width:1500px;margin:0 auto;padding:0 clamp(18px,5.66vw,85px)">
      <h2 style="margin:0;font-family:'Archivo',sans-serif;font-weight:700;font-size:clamp(28px,4.88vw,50px);line-height:1;letter-spacing:-.013em;color:#fff">{jahr.titel}</h2>
      <div style="width:100%;height:2px;background:rgba(255,255,255,.9);margin:clamp(12px,1.8vw,22px) 0 clamp(18px,2.6vw,30px)"></div>

      {urkundeMode ? (
        <div style="margin:clamp(20px,3.2vw,34px) 0 0;display:flex;flex-wrap:wrap;gap:clamp(24px,4vw,44px);align-items:center">
          <div style="flex:1 1 380px;min-width:280px;max-width:600px;display:flex;flex-direction:column;justify-content:center;gap:1.4em;font-family:'Archivo',sans-serif;font-size:clamp(16px,2.05vw,21px);line-height:1.5;letter-spacing:.024em;color:#fff;text-wrap:pretty" set:html={fliesstext}></div>
          <div style="flex:0 1 430px;min-width:240px;position:relative">
            <img src="/assets/rahmen.png" alt="" style="width:100%;height:auto;position:relative;z-index:2;pointer-events:none" />
            <img src={intro[0].bild} alt={intro[0].alt} data-lightbox data-lightbox-src={intro[0].bild} style="position:absolute;left:12.5%;top:7.5%;width:75%;height:85%;object-fit:cover;z-index:1;cursor:zoom-in" />
          </div>
        </div>
      ) : (
        <>
          {kennzahlen && <p style="margin:0 0 clamp(20px,3vw,30px);font-family:'Archivo',sans-serif;font-size:clamp(16px,2.05vw,21px);line-height:1.5;letter-spacing:.024em;color:#fff" set:html={kennzahlen}></p>}
          {intro.length > 0 && (
            <div class="rb-intro" style={`display:grid;grid-template-columns:repeat(${introSpalten},1fr);gap:clamp(12px,1.8vw,19px)`}>
              {intro.map((im, i) => (
                isVideo(im.bild)
                  ? <video class:list={['rb-intro-bild', { 'rb-intro-breit': introBreit(i) }]} src={im.bild} controls playsinline preload="metadata" style="width:100%;aspect-ratio:363/226;object-fit:cover;background:#000"></video>
                  : <img class:list={['rb-intro-bild', { 'rb-intro-breit': introBreit(i) }]} src={im.bild} alt={im.alt} data-lightbox data-lightbox-src={im.bild} style="width:100%;aspect-ratio:363/226;object-fit:cover" />
              ))}
            </div>
          )}
          {fliesstext && <div style="margin:clamp(24px,3.6vw,38px) auto 0;max-width:min(100%,760px);display:flex;flex-direction:column;gap:1.4em;font-family:'Archivo',sans-serif;font-size:clamp(16px,2.05vw,21px);line-height:1.5;letter-spacing:.024em;color:#fff;text-wrap:pretty" set:html={fliesstext}></div>}
        </>
      )}
    </div>
  </section>

  {acts.length > 0 && (
    <section style="background:#ffdd00 url(/assets/grain.png) center/100% 100% no-repeat;padding:clamp(34px,5.2vw,53px) 0 clamp(40px,5.5vw,58px)">
      <div style="max-width:1500px;margin:0 auto;padding:0 clamp(18px,5.66vw,85px)">
        <h2 style="margin:0;text-align:center;font-family:'Archivo',sans-serif;font-weight:700;font-size:clamp(28px,4.88vw,50px);line-height:1;letter-spacing:-.013em;color:#4b2e83">{jahr.jahr} Line-Up</h2>
        <div style="width:100%;height:2px;background:#4b2e83;margin:clamp(12px,1.8vw,22px) 0 clamp(22px,3.2vw,40px)"></div>
        {acts.map((act, idx) => (
          <div style={idx < acts.length - 1 ? 'margin-bottom:clamp(26px,4vw,42px)' : ''}>
            <h3 style="margin:0;font-family:'Archivo',sans-serif;font-weight:700;font-size:clamp(20px,2.73vw,28px);line-height:1.1;letter-spacing:-.013em;color:#4b2e83;white-space:pre-line">{act.name}</h3>
            {act.beschreibung && <p style="margin:.25em 0 clamp(12px,1.6vw,17px);font-family:'Archivo',sans-serif;font-weight:400;font-size:clamp(15px,1.95vw,20px);line-height:1.4;letter-spacing:.02em;color:#4b2e83;white-space:pre-line">{act.beschreibung}</p>}
            <BandLinks links={act.links} />
            <div class:list={['rb-fotos', { 'rb-einzeln': [act.foto_a, act.foto_b, act.foto_c].filter(Boolean).length === 1, 'rb-drei': [act.foto_a, act.foto_b, act.foto_c].filter(Boolean).length === 3 }]} style="display:flex;flex-wrap:wrap;gap:clamp(12px,1.4vw,15px);margin-top:clamp(8px,1vw,12px)">
              {[act.foto_a, act.foto_b, act.foto_c].filter(Boolean).map((f) => (
                isVideo(f)
                  ? <video class="rb-foto" src={f} controls playsinline preload="metadata" style="flex:1 1 42%;min-width:280px;width:100%;aspect-ratio:435/326;object-fit:cover;background:#000"></video>
                  : <img class="rb-foto" src={f} alt={`${act.name} bei ${jahr.titel}`} data-lightbox data-lightbox-src={f} style="flex:1 1 42%;min-width:280px;width:100%;aspect-ratio:435/326;object-fit:cover" />
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  {presse.length > 0 && (
    <section style="background:#4b2e83;padding:clamp(34px,5.2vw,53px) 0 clamp(40px,5.5vw,58px)">
      <div style="max-width:1500px;margin:0 auto;padding:0 clamp(18px,5.66vw,85px)">
        <h2 style="margin:0;text-align:center;font-family:'Archivo',sans-serif;font-weight:700;font-size:clamp(28px,4.88vw,50px);line-height:1;letter-spacing:-.013em;color:#fff">{jahr.jahr} Presse</h2>
        <div style="width:100%;height:2px;background:rgba(255,255,255,.9);margin:clamp(12px,1.8vw,22px) 0 clamp(22px,3.2vw,40px)"></div>

        {collageMode && collageItems.length > 0 ? (
          <>
            <div class="rb-collage" style="position:relative;width:100%;aspect-ratio:978/1223">
              {collageItems.map(({ p, l, t, w }) => (
                <img src={p.bild} alt={p.alt} data-lightbox data-lightbox-src={p.bild} style={`position:absolute;left:${l}%;top:${t}%;width:${w}%;box-shadow:0 8px 24px rgba(0,0,0,.35);cursor:zoom-in`} />
              ))}
            </div>
            <div class="rb-pressegrid" style="display:none;grid-template-columns:repeat(2,1fr);gap:12px;align-items:start">
              {presse.map((p) => (
                <img src={p.bild} alt={p.alt} data-lightbox data-lightbox-src={p.bild} style="width:100%;cursor:zoom-in;box-shadow:0 8px 24px rgba(0,0,0,.35)" />
              ))}
            </div>
          </>
        ) : (
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:clamp(14px,2vw,22px);align-items:start">
            {presse.map((p) => (
              isVideo(p.bild)
                ? <video src={p.bild} controls playsinline preload="metadata" style="width:100%;background:#000;box-shadow:0 8px 24px rgba(0,0,0,.35)"></video>
                : <img src={p.bild} alt={p.alt} data-lightbox data-lightbox-src={p.bild} style="width:100%;cursor:zoom-in;box-shadow:0 8px 24px rgba(0,0,0,.35)" />
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <style>
    /* Übriges Intro-Bild bei zwei Spalten: ganze Breite, flacheres Format */
    .rb-intro-breit { grid-column: 1 / -1; aspect-ratio: 12 / 5 !important; object-position: center 40%; }
    /* Auf dem Handy stehen die Intro-Bilder untereinander */
    @media (max-width: 640px) {
      .rb-intro { grid-template-columns: 1fr !important; }
      .rb-intro-breit { aspect-ratio: 363 / 226 !important; }
    }
    /* Band mit nur einem Foto: Das Foto nutzt die ganze Breite in flacherem Format,
       damit es nicht riesig wird. Der Bildausschnitt liegt etwas über der Mitte,
       weil dort meist die Gesichter sind. Auf schmalen Schirmen bleibt 4:3. */
    @media (min-width: 700px) {
      .rb-fotos.rb-einzeln .rb-foto { flex-basis: 100% !important; aspect-ratio: 2 / 1 !important; object-position: center 35%; }
      /* Drei Fotos stehen in einer Reihe */
      .rb-fotos.rb-drei .rb-foto { flex-basis: 30% !important; min-width: 0 !important; }
    }
    /* Presse-Collage nur auf breiten Schirmen; darunter Raster (wie im Original) */
    @media (max-width: 860px) {
      .rb-collage { display: none !important; }
      .rb-pressegrid { display: grid !important; }
    }
  </style>
</Base>
