---
import Base from '../layouts/Base.astro';
import BandLinks from '../components/BandLinks.astro';
import { getTable } from '../lib/content.js';

export async function getStaticPaths() {
  const einstellungen = await getTable('einstellungen', { single: true });
  const alle = await getTable('rueckblick_jahre', {
    select: '*,rueckblick_intro(*),rueckblick_acts(*,links:rueckblick_act_links(*)),rueckblick_presse(*)',
    order: 'reihenfolge.desc',
  });
  const jahre = (alle || []).filter((j) => j.sichtbar !== false);
  return jahre.map((j) => ({ params: { slug: j.slug }, props: { jahr: j, einstellungen, jahre } }));
}

const { jahr, einstellungen, jahre } = Astro.props;
const byR = (a, b) => (a.reihenfolge ?? 0) - (b.reihenfolge ?? 0);
const intro = [...(jahr.rueckblick_intro || [])].sort(byR);
const acts = [...(jahr.rueckblick_acts || [])].sort(byR);
const presse = [...(jahr.rueckblick_presse || [])].sort(byR);
const isVideo = (s) => /\.(mp4|webm|mov|m4v)$/i.test(s || '');
---
<Base active="rueckblick" activeSlug={jahr.slug} einstellungen={einstellungen} jahre={jahre} title={`${jahr.titel} – Rock4Aid`}>
  <section id="rueckblick" style="background:#4b2e83;padding:clamp(34px,5.2vw,53px) 0 clamp(40px,5vw,52px)">
    <div style="max-width:1500px;margin:0 auto;padding:0 clamp(18px,5.66vw,85px)">
      <h2 style="margin:0;font-family:'Archivo',sans-serif;font-weight:700;font-size:clamp(28px,4.88vw,50px);line-height:1;letter-spacing:-.013em;color:#fff">{jahr.titel}</h2>
      <div style="width:100%;height:2px;background:rgba(255,255,255,.9);margin:clamp(12px,1.8vw,22px) 0 clamp(18px,2.6vw,30px)"></div>
      {jahr.kennzahlen && <p style="margin:0 0 clamp(20px,3vw,30px);font-family:'Archivo',sans-serif;font-size:clamp(16px,2.05vw,21px);line-height:1.5;letter-spacing:.024em;color:#fff" set:html={jahr.kennzahlen}></p>}

      {intro.length === 1 && intro[0].rahmen ? (
        <div style="margin:0 auto;max-width:430px;position:relative">
          <img src="/assets/rahmen.png" alt="" style="width:100%;height:auto;position:relative;z-index:2;pointer-events:none" />
          <img src={intro[0].bild} alt={intro[0].alt} data-lightbox data-lightbox-src={intro[0].bild} style="position:absolute;left:12.5%;top:7.5%;width:75%;height:85%;object-fit:cover;z-index:1" />
        </div>
      ) : intro.length > 0 ? (
        <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(12px,1.8vw,19px)">
          {intro.map((im) => (
            isVideo(im.bild)
              ? <video src={im.bild} controls playsinline preload="metadata" style="width:100%;aspect-ratio:363/226;object-fit:cover;background:#000"></video>
              : <img src={im.bild} alt={im.alt} data-lightbox data-lightbox-src={im.bild} style="width:100%;aspect-ratio:363/226;object-fit:cover" />
          ))}
        </div>
      ) : null}

      {jahr.fliesstext && <div style="margin:clamp(24px,3.6vw,38px) auto 0;max-width:min(100%,760px);display:flex;flex-direction:column;gap:1.4em;font-family:'Archivo',sans-serif;font-size:clamp(16px,2.05vw,21px);line-height:1.5;letter-spacing:.024em;color:#fff;text-wrap:pretty" set:html={jahr.fliesstext}></div>}
    </div>
  </section>

  {acts.length > 0 && (
    <section style="background:#ffdd00 url(/assets/grain.png) center/100% 100% no-repeat;padding:clamp(34px,5.2vw,53px) 0 clamp(40px,5.5vw,58px)">
      <div style="max-width:1500px;margin:0 auto;padding:0 clamp(18px,5.66vw,85px)">
        <h2 style="margin:0;text-align:center;font-family:'Archivo',sans-serif;font-weight:700;font-size:clamp(28px,4.88vw,50px);line-height:1;letter-spacing:-.013em;color:#4b2e83">{jahr.jahr} Line-Up</h2>
        <div style="width:100%;height:2px;background:#4b2e83;margin:clamp(12px,1.8vw,22px) 0 clamp(22px,3.2vw,40px)"></div>
        {acts.map((act, idx) => (
          <div style={idx < acts.length - 1 ? 'margin-bottom:clamp(26px,4vw,42px)' : ''}>
            <h3 style="margin:0;font-family:'Archivo',sans-serif;font-weight:700;font-size:clamp(20px,2.73vw,28px);line-height:1.1;letter-spacing:-.013em;color:#4b2e83">{act.name}</h3>
            {act.beschreibung && <p style="margin:.25em 0 clamp(12px,1.6vw,17px);font-family:'Archivo',sans-serif;font-weight:400;font-size:clamp(15px,1.95vw,20px);line-height:1.4;letter-spacing:.02em;color:#4b2e83">{act.beschreibung}</p>}
            <BandLinks links={act.links} />
            <div style="display:flex;flex-wrap:wrap;gap:clamp(12px,1.4vw,15px);margin-top:clamp(8px,1vw,12px)">
              {[act.foto_a, act.foto_b].filter(Boolean).map((f) => (
                isVideo(f)
                  ? <video src={f} controls playsinline preload="metadata" style="flex:1 1 42%;min-width:280px;width:100%;aspect-ratio:435/326;object-fit:cover;background:#000"></video>
                  : <img src={f} alt={`${act.name} bei ${jahr.titel}`} data-lightbox data-lightbox-src={f} style="flex:1 1 42%;min-width:280px;width:100%;aspect-ratio:435/326;object-fit:cover" />
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  {presse.length > 0 && (
    <section style="background:#4b2e83;padding:clamp(34px,5.2vw,53px) 0 clamp(40px,5.5vw,58px)">
      <div style="max-width:1500px;margin:0 auto;padding:0 clamp(18px,5.66vw,85px)">
        <h2 style="margin:0;text-align:center;font-family:'Archivo',sans-serif;font-weight:700;font-size:clamp(28px,4.88vw,50px);line-height:1;letter-spacing:-.013em;color:#fff">{jahr.jahr} Presse</h2>
        <div style="width:100%;height:2px;background:rgba(255,255,255,.9);margin:clamp(12px,1.8vw,22px) 0 clamp(22px,3.2vw,40px)"></div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:clamp(14px,2vw,22px);align-items:start">
          {presse.map((p) => (
            isVideo(p.bild)
              ? <video src={p.bild} controls playsinline preload="metadata" style="width:100%;background:#000;box-shadow:0 8px 24px rgba(0,0,0,.35)"></video>
              : <img src={p.bild} alt={p.alt} data-lightbox data-lightbox-src={p.bild} style="width:100%;box-shadow:0 8px 24px rgba(0,0,0,.35)" />
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
