---
import Base from '../layouts/Base.astro';
import { getTable, cleanUrl } from '../lib/content.js';

const einstellungen = await getTable('einstellungen', { single: true });
const jahre = await getTable('rueckblick_jahre', { order: 'reihenfolge.desc' });
const m = await getTable('mitglied', { single: true });
const abschnitte = (await getTable('mitglied_abschnitte', { order: 'reihenfolge.asc' }))
  .filter((a) => a.sichtbar !== false);
// Abwechselnd gelb/weiß wie auf der Seite „Über uns“
// Der letzte Abschnitt vor dem (weißen) Formular ist immer gelb
const versatz = abschnitte.length % 2 === 0 ? 1 : 0;
const bg = (i) => ((i + versatz) % 2 === 0 ? '#ffdd00 url(/assets/grain.png) center/100% 100% no-repeat' : '#fff');
const hidden = einstellungen.mitglied_sichtbar === false || m.sichtbar === false;

const SB_URL = cleanUrl(import.meta.env.PUBLIC_SUPABASE_URL);
const SB_KEY = (import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '').trim();
const formularAktiv = m.formular_aktiv !== false && Boolean(SB_URL && SB_KEY);
const mindest = Number(m.mindestbetrag || 12);
const vorschlaege = String(m.vorschlagsbetraege || '24, 60, 120')
  .split(',').map((x) => Number(x.trim())).filter((x) => x >= mindest);
const glaeubigerId = (m.glaeubiger_id || '').trim();

// Pflichttext des SEPA-Lastschriftmandats. Er wird so, wie der Antragsteller
// ihn gesehen hat, mit dem Antrag gespeichert.
const verein = 'Rock4Aid e.V.';
const mandatText = `SEPA-Lastschriftmandat: Ich ermächtige ${verein}${glaeubigerId ? ` (Gläubiger-Identifikationsnummer ${glaeubigerId})` : ''}, den jährlichen Förderbeitrag von meinem Konto mittels Lastschrift einzuziehen. Zugleich weise ich mein Kreditinstitut an, die von ${verein} auf mein Konto gezogenen Lastschriften einzulösen. Die Mandatsreferenz wird mir gesondert mitgeteilt. Hinweis: Ich kann innerhalb von acht Wochen, beginnend mit dem Belastungsdatum, die Erstattung des belasteten Betrages verlangen. Es gelten dabei die mit meinem Kreditinstitut vereinbarten Bedingungen.`;

const H2 = "margin:0;text-align:center;font-family:'Archivo',sans-serif;font-weight:700;font-size:clamp(26px,4.2vw,44px);line-height:1.05;letter-spacing:-.013em;text-wrap:balance";
---
<Base active="mitglied" einstellungen={einstellungen} jahre={jahre} title="Mitglied werden – Rock4Aid" noindex={hidden}>
  {hidden ? (
    <section style="background:#4b2e83;padding:clamp(60px,10vw,140px) 5.66%;text-align:center;min-height:40vh">
      <p style="font-family:'Archivo',sans-serif;font-weight:600;font-size:clamp(18px,2.6vw,30px);color:#fff">Diese Seite ist derzeit nicht veröffentlicht.</p>
    </section>
  ) : (
    <>
      <section style="position:relative;background:#4b2e83;overflow:hidden;min-height:min(26vw,360px)">
        {m.hero_bild && <img class="r4a-anim" src={m.hero_bild} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;animation:r4aPan 30s ease-in-out infinite" />}
        {m.hero_bild && <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(18,10,32,.62) 0%,rgba(18,10,32,.45) 100%)"></div>}
        <div style="position:relative;max-width:1500px;margin:0 auto;padding:clamp(34px,5.2vw,64px) 5.66% clamp(40px,6vw,80px)">
          <h1 style={`${H2};color:#fff;font-size:clamp(28px,4.88vw,50px)`}>{m.hero_titel || 'Mitglied werden'}</h1>
          <div style="width:100%;height:2px;background:rgba(255,255,255,.9);margin:clamp(12px,1.8vw,22px) 0 0"></div>
          {m.intro_text && <div class="mw-text" style="margin:clamp(18px,2.6vw,34px) auto 0;max-width:min(80%,860px);text-align:center;font-family:'Archivo',sans-serif;font-size:clamp(17px,1.9vw,23px);line-height:1.55;color:#fff" set:html={m.intro_text}></div>}
        </div>
      </section>

      {abschnitte.map((a, i) => (
        <section style={`background:${bg(i)};padding:clamp(30px,4.8vw,72px) 0 clamp(36px,5.5vw,82px)`}>
          <div style="max-width:1500px;margin:0 auto;padding:0 5.66%">
            {a.titel && <h2 style={`${H2};color:#4b2e83`}>{a.titel}</h2>}
            {a.titel && <div style="width:100%;height:2px;background:#4b2e83;margin:clamp(12px,1.8vw,22px) 0 0"></div>}
            <div style={`margin:clamp(24px,3.8vw,50px) 0 0;display:flex;flex-wrap:wrap;gap:clamp(22px,4vw,60px);align-items:center;flex-direction:${a.bild_rechts ? 'row-reverse' : 'row'}`}>
              {a.bild && <img src={a.bild} alt="" loading="lazy" style="flex:1 1 40%;min-width:260px;width:100%;height:auto;max-height:560px;object-fit:contain" />}
              <div class="mw-text" style={`flex:1 1 ${a.bild ? '44%' : '100%'};min-width:280px;display:flex;flex-direction:column;gap:.9em;text-align:left;font-family:'Archivo',sans-serif;font-size:clamp(16px,1.6vw,20px);line-height:1.6;color:#4b2e83;text-wrap:pretty`} set:html={a.text}></div>
            </div>
          </div>
        </section>
      ))}

      <section id="antrag" style="background:#fff;padding:clamp(30px,4.8vw,72px) 0 clamp(40px,6vw,90px)">
        <div style="max-width:900px;margin:0 auto;padding:0 5.66%">
          <h2 style={`${H2};color:#4b2e83`}>{formularAktiv ? (m.formular_titel || 'Fördermitgliedschaft beantragen') : 'So werdet ihr Fördermitglied'}</h2>
          <div style="width:100%;height:2px;background:#4b2e83;margin:clamp(12px,1.8vw,22px) 0 clamp(20px,3vw,36px)"></div>

          {formularAktiv && m.formular_text && <div class="mw-text mw-vor" set:html={m.formular_text}></div>}

          {!formularAktiv ? (
            <p class="mw-hinweis mw-vor">Den Online-Antrag schalten wir in Kürze frei. Bis dahin schreibt uns einfach eine E-Mail, dann melden wir uns bei euch.</p>
          ) : (
            <form id="mw-form" class="mw-form" novalidate>
              <fieldset>
                <legend>Euer jährlicher Förderbeitrag</legend>
                <div class="mw-betraege">
                  {vorschlaege.map((b) => (
                    <label class="mw-chip"><input type="radio" name="betrag_wahl" value={String(b)} /> {b} €</label>
                  ))}
                  <label class="mw-chip"><input type="radio" name="betrag_wahl" value="frei" checked /> eigener Betrag</label>
                </div>
                <label class="mw-feld">Betrag pro Jahr in Euro (mindestens {mindest} €)
                  <input name="betrag" type="number" min={mindest} step="1" inputmode="numeric" required />
                </label>
              </fieldset>

              <fieldset>
                <legend>Eure Angaben</legend>
                <div class="mw-grid">
                  <label class="mw-feld">Vorname<input name="vorname" required autocomplete="given-name" /></label>
                  <label class="mw-feld">Nachname<input name="nachname" required autocomplete="family-name" /></label>
                  <label class="mw-feld mw-breit">Straße und Hausnummer<input name="strasse" required autocomplete="street-address" /></label>
                  <label class="mw-feld">PLZ<input name="plz" required inputmode="numeric" autocomplete="postal-code" /></label>
                  <label class="mw-feld">Ort<input name="ort" required autocomplete="address-level2" /></label>
                  <label class="mw-feld">E-Mail<input name="email" type="email" required autocomplete="email" /></label>
                  <label class="mw-feld">Telefon (freiwillig)<input name="telefon" type="tel" autocomplete="tel" /></label>
                </div>
              </fieldset>

              <fieldset>
                <legend>Bankverbindung für die Lastschrift</legend>
                <div class="mw-grid">
                  <label class="mw-feld mw-breit">Kontoinhaber<input name="kontoinhaber" required autocomplete="name" /></label>
                  <label class="mw-feld mw-breit">IBAN<input name="iban" required autocomplete="off" spellcheck="false" placeholder="DE00 0000 0000 0000 0000 00" /></label>
                  <label class="mw-feld">BIC (freiwillig)<input name="bic" autocomplete="off" spellcheck="false" /></label>
                </div>
                <p class="mw-mandat">{mandatText}</p>
                <label class="mw-check"><input type="checkbox" name="mandat" required /> Ich erteile dieses SEPA-Lastschriftmandat.</label>
                <label class="mw-check"><input type="checkbox" name="datenschutz" required /> Ich habe die <a href="/datenschutz/" target="_blank" rel="noopener">Datenschutzerklärung</a> gelesen und bin mit der Verarbeitung meiner Angaben für die Fördermitgliedschaft einverstanden.</label>
              </fieldset>

              <p id="mw-fehler" class="mw-fehler" role="alert" hidden></p>
              <button type="submit" id="mw-senden" class="mw-senden">Fördermitgliedschaft beantragen</button>
            </form>
          )}
          <div id="mw-danke" class="mw-danke" hidden set:html={m.danke_text || '<p>Vielen Dank! Wir haben euren Antrag erhalten.</p>'}></div>
          {m.formular_nachtext && <div class="mw-text mw-nach" set:html={m.formular_nachtext}></div>}
        </div>
      </section>
    </>
  )}

  <script define:vars={{ SB_URL, SB_KEY, mandatText, mindest }}>
    (function () {
      const form = document.getElementById('mw-form');
      if (!form) return;
      const betrag = form.elements.betrag;
      form.querySelectorAll('input[name="betrag_wahl"]').forEach((r) => r.addEventListener('change', () => {
        if (r.checked && r.value !== 'frei') betrag.value = r.value;
        if (r.checked && r.value === 'frei') { betrag.value = ''; betrag.focus(); }
      }));
      betrag.addEventListener('input', () => {
        const frei = form.querySelector('input[name="betrag_wahl"][value="frei"]');
        if (frei) frei.checked = true;
      });
      function ibanOk(iban) {
        const s = iban.replace(/\s/g, '').toUpperCase();
        if (!/^[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}$/.test(s)) return false;
        const r = s.slice(4) + s.slice(0, 4);
        let rest = 0;
        for (const ch of r) {
          const v = /[A-Z]/.test(ch) ? String(ch.charCodeAt(0) - 55) : ch;
          for (const d of v) rest = (rest * 10 + Number(d)) % 97;
        }
        return rest === 1;
      }
      const fehler = document.getElementById('mw-fehler');
      function zeigeFehler(t) { fehler.textContent = t; fehler.hidden = false; fehler.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        fehler.hidden = true;
        const f = form.elements;
        const b = Number(f.betrag.value);
        if (!b || b < mindest) return zeigeFehler(`Bitte einen Jahresbetrag von mindestens ${mindest} € eingeben.`);
        for (const k of ['vorname', 'nachname', 'strasse', 'plz', 'ort', 'email', 'kontoinhaber', 'iban']) {
          if (!f[k].value.trim()) return zeigeFehler('Bitte alle Pflichtfelder ausfüllen.');
        }
        if (!/^\S+@\S+\.\S+$/.test(f.email.value.trim())) return zeigeFehler('Bitte eine gültige E-Mail-Adresse eingeben.');
        if (!ibanOk(f.iban.value)) return zeigeFehler('Die IBAN ist nicht gültig. Bitte noch einmal prüfen.');
        if (!f.mandat.checked) return zeigeFehler('Bitte das SEPA-Lastschriftmandat bestätigen.');
        if (!f.datenschutz.checked) return zeigeFehler('Bitte der Datenschutzerklärung zustimmen.');
        const btn = document.getElementById('mw-senden');
        btn.disabled = true; btn.textContent = 'Wird gesendet …';
        try {
          const res = await fetch(`${SB_URL}/rest/v1/rpc/foerderantrag_stellen`, {
            method: 'POST',
            headers: { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}`, 'Content-Type': 'application/json' },
            body: JSON.stringify({
              p_vorname: f.vorname.value, p_nachname: f.nachname.value, p_strasse: f.strasse.value,
              p_plz: f.plz.value, p_ort: f.ort.value, p_email: f.email.value, p_telefon: f.telefon.value,
              p_betrag: b, p_kontoinhaber: f.kontoinhaber.value, p_iban: f.iban.value, p_bic: f.bic.value,
              p_mandat_zustimmung: true, p_mandat_text: mandatText, p_datenschutz_ok: true,
            }),
          });
          if (!res.ok) {
            let msg = 'Der Antrag konnte nicht gesendet werden. Bitte versucht es später noch einmal.';
            try { const j = await res.json(); if (j && j.message) msg = j.message; } catch (_) { /* ignore */ }
            throw new Error(msg);
          }
          form.hidden = true;
          const d = document.getElementById('mw-danke');
          d.hidden = false; d.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } catch (err) {
          zeigeFehler(err.message);
          btn.disabled = false; btn.textContent = 'Fördermitgliedschaft beantragen';
        }
      });
    })();
  </script>

  <style>
    .mw-text :global(p) { margin:0 0 .7em; }
    .mw-vor, .mw-nach { font-family:'Archivo',sans-serif; font-size:clamp(16px,1.6vw,20px); line-height:1.6; color:#4b2e83; }
    .mw-vor { margin:0 0 clamp(20px,3vw,34px); }
    .mw-nach { margin:clamp(26px,3.6vw,44px) 0 0; text-align:center; }
    .mw-text :global(a) { color:inherit; font-weight:600; text-decoration:underline; text-underline-offset:.15em; }
    .mw-text :global(ul) { margin:0; padding-left:1.2em; }
    .mw-text :global(li) { margin:.3em 0; }
    .mw-form { display:flex; flex-direction:column; gap:26px; font-family:'Archivo',sans-serif; color:#4b2e83; }
    .mw-form fieldset { border:2px solid #4b2e83; border-radius:10px; padding:18px clamp(14px,2.4vw,26px) 22px; margin:0; }
    .mw-form legend { font-weight:700; font-size:clamp(17px,1.8vw,21px); padding:0 8px; }
    .mw-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px 18px; }
    .mw-breit { grid-column:1 / -1; }
    .mw-feld { display:flex; flex-direction:column; gap:6px; font-weight:600; font-size:15px; }
    .mw-feld input { padding:12px 14px; border:1.5px solid #b9acd3; border-radius:8px; font:inherit; font-weight:400; font-size:16px; color:#2a1a4a; }
    .mw-feld input:focus { outline:2px solid #ffdd00; border-color:#4b2e83; }
    .mw-betraege { display:flex; flex-wrap:wrap; gap:10px; margin:6px 0 16px; }
    .mw-chip { display:inline-flex; align-items:center; gap:8px; padding:10px 16px; border:2px solid #4b2e83; border-radius:999px; font-weight:700; cursor:pointer; }
    .mw-chip:has(input:checked) { background:#4b2e83; color:#fff; }
    .mw-mandat { font-size:14px; line-height:1.55; background:#f4f0fa; border-radius:8px; padding:12px 14px; margin:18px 0 12px; }
    .mw-check { display:flex; gap:10px; align-items:flex-start; font-size:15px; line-height:1.5; margin:8px 0; }
    .mw-check input { width:20px; height:20px; margin-top:2px; flex:0 0 auto; }
    .mw-check a { color:#4b2e83; text-decoration:underline; }
    .mw-fehler { background:#fde8e8; color:#a12020; border-radius:8px; padding:12px 14px; font-weight:600; margin:0; }
    .mw-senden { background:#4b2e83; color:#fff; border:0; border-radius:999px; padding:16px 28px; font:inherit; font-weight:700; font-size:18px; cursor:pointer; align-self:center; }
    .mw-senden:hover { background:#3d2569; }
    .mw-senden:disabled { opacity:.6; cursor:default; }
    .mw-danke { background:#ffdd00; color:#4b2e83; border-radius:12px; padding:24px; font-family:'Archivo',sans-serif; font-size:clamp(17px,1.9vw,22px); text-align:center; }
    .mw-hinweis { font-family:'Archivo',sans-serif; color:#4b2e83; font-size:18px; text-align:center; }
    @media (max-width:640px) { .mw-grid { grid-template-columns:1fr; } }
  </style>
</Base>
