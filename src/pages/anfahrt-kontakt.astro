---
import Base from '../layouts/Base.astro';
import { getTable } from '../lib/content.js';

const einstellungen = await getTable('einstellungen', { single: true });
const jahre = await getTable('rueckblick_jahre', { order: 'reihenfolge.desc' });
const a = await getTable('anfahrt', { single: true });
const hidden = einstellungen.anfahrt_sichtbar === false || a.sichtbar === false;

const esc = (s) => (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const multiline = (s) => esc(s).split('\n').join('<br />');
const kontaktHtml = esc(a.kontakt_text || '').split('\n')
  .map((line) => (line.includes('@')
    ? `<a href="mailto:${line.trim()}" style="color:#4b2e83;border-bottom:1px solid rgba(75,46,131,.45)">${line.trim()}</a>`
    : line)).join('<br />');

const cards = [
  { titel: a.ort_titel || 'Veranstaltungsort', html: multiline(a.ort_text) },
  { titel: a.datum_titel || 'Datum & Uhrzeit', html: multiline(a.datum_text) },
  { titel: a.kontakt_titel || 'Kontakt', html: kontaktHtml },
];
---
<Base active="anfahrt" einstellungen={einstellungen} jahre={jahre} title="Anfahrt & Kontakt – Rock4Aid" noindex={hidden}>
  {hidden ? (
    <section style="background:#4b2e83;padding:clamp(60px,10vw,140px) 5.66%;text-align:center;min-height:40vh">
      <p style="font-family:'Archivo',sans-serif;font-weight:600;font-size:clamp(18px,2.6vw,30px);color:#fff">Diese Seite ist derzeit nicht veröffentlicht.</p>
    </section>
  ) : (
    <>
      <section id="anfahrt" style="position:relative;overflow:hidden;background:#e8ecef;padding:clamp(30px,4.8vw,72px) 0 clamp(34px,5vw,75px)">
        {a.karte_bild && <img src={a.karte_bild} alt="" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />}
        <div style="position:absolute;inset:0;background:rgba(247,249,250,.12)"></div>
        <div style="position:relative;max-width:1500px;margin:0 auto;padding:0 5.66%">
          <h1 style="margin:0;text-align:center;font-family:'Archivo',sans-serif;font-weight:700;font-size:clamp(28px,4.88vw,50px);line-height:1;letter-spacing:-.013em;color:#4b2e83">Anfahrt &amp; Kontakt</h1>
          <div style="width:100%;height:2px;background:#4b2e83;margin:clamp(12px,1.8vw,22px) 0 0"></div>
          {a.eintritt_zeile && <p style="margin:clamp(12px,2vw,30px) 0 clamp(22px,3.2vw,48px);text-align:center;font-family:'Archivo',sans-serif;font-weight:600;font-size:clamp(16px,2.93vw,38px);line-height:1.2;color:#4b2e83">{a.eintritt_zeile}</p>}
          <div style="display:flex;flex-wrap:wrap;gap:clamp(14px,1.5vw,22px);align-items:stretch">
            {cards.map((card) => (
              <div style="flex:1 1 28%;min-width:250px;background:#efc900;border-radius:10px;box-shadow:0 6px 20px rgba(20,10,45,.28);padding:clamp(14px,2.2vw,33px) clamp(12px,2vw,30px) clamp(18px,2.8vw,42px);display:flex;flex-direction:column;align-items:center;gap:clamp(12px,1.8vw,27px)">
                <p style="margin:0;width:100%;background:#4b2e83;color:#fff;text-align:center;border-radius:999px;padding:clamp(10px,1.4vw,21px) 8px;font-family:'Archivo',sans-serif;font-weight:700;font-size:clamp(14px,1.86vw,24px);line-height:1;letter-spacing:.02em">{card.titel}</p>
                <p style="margin:0;text-align:center;font-family:'Archivo',sans-serif;font-weight:400;font-size:clamp(14px,1.76vw,22px);line-height:1.5;color:#3b2c1e" set:html={card.html}></p>
              </div>
            ))}
          </div>
          <div style="margin:clamp(22px,3.2vw,48px) 0 0;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px">
            <a href={a.karte_link} target="_blank" rel="noopener" style="background:#4b2e83;color:#fff;font-family:'Archivo',sans-serif;font-weight:700;font-size:16px;padding:12px 20px;border-radius:999px;box-shadow:0 6px 18px rgba(20,10,45,.35)">Route planen ↗</a>
            <span style="font-family:'Archivo',sans-serif;font-size:12px;color:#3b2c1e;opacity:.85">© OpenStreetMap-Mitwirkende</span>
          </div>
        </div>
      </section>

      <section style="background:#4b2e83;padding:clamp(30px,4.6vw,69px) 0 clamp(34px,5vw,75px)">
        <div style="max-width:1500px;margin:0 auto;padding:0 5.66%;display:flex;flex-wrap:wrap;gap:clamp(24px,4vw,60px);align-items:center">
          {a.veranstalter_bild && <img src={a.veranstalter_bild} alt="Rock4Aid" style="flex:1 1 40%;min-width:260px;width:100%;aspect-ratio:455/461;object-fit:cover" />}
          <div style="flex:1 1 44%;min-width:280px">
            <h2 style="margin:0 0 clamp(16px,2.4vw,26px);font-family:'Archivo',sans-serif;font-weight:700;font-size:clamp(24px,3.42vw,44px);line-height:1.1;color:#fff">{a.veranstalter_titel || 'Veranstalter'}</h2>
            <div style="width:100%;height:2px;background:rgba(255,255,255,.9);margin:0 0 clamp(12px,1.8vw,22px)"></div>
            <div style="display:flex;flex-direction:column;gap:1.4em;font-family:'Archivo',sans-serif;font-weight:400;font-size:clamp(14px,1.76vw,22px);line-height:1.5;color:#fff;text-wrap:pretty" set:html={a.veranstalter_text}></div>
          </div>
        </div>
      </section>
    </>
  )}
</Base>
