---
import Base from '../layouts/Base.astro';
import { getTable } from '../lib/content.js';

const einstellungen = await getTable('einstellungen', { single: true });
const sponsorenRaw = await getTable('sponsoren', { order: 'reihenfolge.asc', filters: { sichtbar: 'eq.true' } });
const sponsoren = (sponsorenRaw || []).filter((x) => x.sichtbar !== false);
const jahre = await getTable('rueckblick_jahre', { order: 'reihenfolge.desc' });

const infoTitel = einstellungen.info_titel || `LineUp & Termin ${einstellungen.festival_jahr || ''}`.trim();
const infoUntertitel = einstellungen.info_untertitel || '';
const claim1 = einstellungen.claim_zeile_1 || 'Live Musik I Essen & Getränke';
const claim2 = einstellungen.claim_zeile_2 || 'Eintritt auf Spendenbasis';
const terminSichtbar = einstellungen.termin_sichtbar !== false;
const festivalDatum = einstellungen.festival_datum || '';
const heroVideo = einstellungen.hero_video || '';
// " I " (Trennzeichen) gelb hervorheben – wie im Design
const claim1Html = claim1.split(' I ').join(' <span style="color:#fff">I</span> ');
// Sponsoren-Logogröße: Stufen klein/mittel/groß → Höhe in px
// Sponsoren-Anzeigegröße: pro Stufe eine feste FLÄCHE (Höhe × Max-Breite).
// Das Logo wird proportional darin eingepasst – unabhängig von seiner Form.
// So bekommt der Hauptsponsor (groß) sichtbar mehr Platz als ein kleiner Sponsor,
// statt dass ein breites Logo die Größe bestimmt.
const LOGO_BOX = { klein: { h: 26, w: 104 }, mittel: { h: 42, w: 165 }, gross: { h: 62, w: 240 } };
const logoBox = (sp) => LOGO_BOX[(sp.groesse || 'mittel').toLowerCase()] || LOGO_BOX.mittel;
---
<Base active="termin" einstellungen={einstellungen} jahre={jahre}>
  <div class="hero-wrap" style="display:flex;flex-direction:column;min-height:calc(100svh - 52px)">
    <section id="start" style="position:relative;background:#141008;overflow:visible;flex:1 1 auto;min-height:230px">
      <div style="position:absolute;inset:0">
        <video src={heroVideo || '/assets/hero-video.mp4'} poster="/assets/hero-poster.jpg" autoplay muted loop playsinline preload="auto" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"></video>
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(15,10,3,.5) 0%,rgba(15,10,3,.08) 26%,rgba(15,10,3,.02) 60%,rgba(15,10,3,.18) 100%)"></div>
        <div class="hero-inner" style="position:absolute;inset:0;padding:3.4% 5.1% 0;display:flex;flex-direction:column">
          <p style="margin:0;text-align:center;font-family:'Archivo',sans-serif;font-weight:700;font-size:clamp(13px,2.83vw,42px);line-height:1.15;letter-spacing:.19em;text-transform:uppercase;color:#fff;text-shadow:0 2px 12px rgba(0,0,0,.55)">Benefiz-Festival</p>
          <div style="width:64%;height:2px;background:rgba(255,255,255,.92);margin:2.2% auto 0"></div>
          <img src="/assets/wordmark.png" alt="Rock4Aid" class="hero-wordmark" style="width:62%;height:auto;flex:1 1 auto;min-height:0;object-fit:contain;margin:auto auto;padding-bottom:1.5%" />
        </div>
      </div>
      {terminSichtbar && festivalDatum && <r4a-countdown class="hero-countdown" target={festivalDatum} aria-hidden="true"></r4a-countdown>}
    </section>

    <section class="info-band" style="background:#4b2e83;padding:1.9% 0 2.2%;flex:0 0 auto">
      <div class="ib-inner" style="margin:0 auto;padding:0 5.1%">
        <div class="ib-top">
          <p style="margin:0;font-family:'Archivo',sans-serif;font-weight:700;font-size:clamp(30px,4.6vw,66px);line-height:1.06;letter-spacing:0;color:#fff;white-space:pre-line;text-wrap:balance">{infoTitel}</p>
          {infoUntertitel && <p style="margin:clamp(6px,1vw,12px) 0 0;font-family:'Archivo',sans-serif;font-weight:600;font-size:clamp(18px,2.344vw,35px);line-height:1.17;letter-spacing:.063em;color:#fff;white-space:pre-line">{infoUntertitel}</p>}
        </div>
        <div class="ib-claims" style="margin:1.7% 0 0;display:flex;flex-wrap:wrap;gap:clamp(18px,2.4vw,28px);align-items:flex-end;justify-content:space-between">
          <div style="flex:1 1 340px;min-width:260px">
            <p style="margin:0;font-family:'Archivo',sans-serif;font-weight:600;font-size:clamp(18px,2.344vw,35px);line-height:1.17;letter-spacing:.063em;color:#fff" set:html={claim1Html}></p>
            <p style="margin:0;font-family:'Archivo',sans-serif;font-weight:600;font-size:clamp(18px,2.344vw,35px);line-height:1.17;letter-spacing:.063em;color:#fff">{claim2}</p>
          </div>
          {sponsoren.length > 0 && (
            <div class="sp-box" style="flex:0 0 auto;background:#fbfefd;border-radius:4px;padding:12px 16px 16px;display:flex;flex-direction:column;gap:10px">
              <p class="sp-title" style="margin:0;font-family:'Archivo',sans-serif;font-weight:600;font-size:15px;line-height:1;color:#4b2e83">Sponsored by:</p>
              <div class="sp-row" style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
                {sponsoren.map((sp) => (
                  <img src={sp.logo} alt={sp.name} class={`sp-logo sp-${(sp.groesse || 'mittel').toLowerCase()}`} style={`max-height:${logoBox(sp).h}px;max-width:${logoBox(sp).w}px;width:auto;height:auto;object-fit:contain`} />
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </section>
  </div>

  <script is:inline src="/js/rock4aid-countdown.js" defer></script>

  <style>
    /* Countdown-Ticket: klebt unten rechts am Hero und ragt leicht in den violetten Block */
    .hero-countdown { position:absolute; right:34px; top:0; z-index:5; pointer-events:none; }
    @media (max-width:640px) {
      /* Mobil: Ticket vollständig im Hero – keine Überlappung mit dem Info-Kasten */
      .hero-countdown { right:12px; top:auto; bottom:6px; transform:scale(.8); transform-origin:bottom right; }
      /* Mobil: Seite füllt den Bildschirm; Footer ganz unten, Info-Bereich wächst */
      .hero-wrap { min-height:calc(100svh - 100px) !important; }
      /* Info-Kasten etwas nach oben, sodass das Ticket sanft über die Kante ragt (Text bleibt frei) */
      .info-band { padding:9% 0 5% !important; margin-top:-22px !important; position:relative; z-index:1; }
      .ib-claims { margin-top:10% !important; }
      .hero-inner { padding-top:8.5% !important; padding-left:3% !important; padding-right:3% !important; }
      /* Logo etwas höher setzen, damit es nicht auf dem Countdown-Störer klebt */
      .hero-wordmark { width:100% !important; padding-bottom:24% !important; }
      /* Mobil: Sponsorenkasten kompakt – EINE schlanke Reihe.
         Stufen klein/mittel/groß über kleine Höhen-/Breiten-Deckel, sodass
         a) der Kasten niedrig bleibt, b) groß>klein gilt und
         c) sehr breite Logos (Volksbank 10,6:1) nicht zum dünnen Streifen kollabieren. */
      .sp-box { padding:5px 10px 7px !important; gap:5px !important; border-radius:6px !important; margin-top:14px !important; }
      .sp-row { flex-direction:row !important; align-items:center !important; gap:12px !important; }
      .sp-title { font-size:10.5px !important; }
      .sp-gross  { max-height:20px !important; max-width:172px !important; }
      .sp-mittel { max-height:16px !important; max-width:132px !important; }
      .sp-klein  { max-height:12px !important; max-width:110px !important; }
    }
  </style>
</Base>
