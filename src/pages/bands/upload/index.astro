---
// Upload-Seite für die Bands: rock4aid.de/bands/upload/<token>
// Es gibt nur diese eine Seite. Netlify leitet alle Token-Adressen hierher um
// (siehe netlify.toml). Das Token liest das Skript aus der Adresse und fragt
// damit die Funktion band-abgabe. Die Seite wird nicht indexiert und steht
// nicht in der Sitemap.
import Base from '../../../layouts/Base.astro';
import { getTable } from '../../../lib/content.js';
const einstellungen = await getTable('einstellungen', { single: true });
const jahre = await getTable('rueckblick_jahre', { order: 'reihenfolge.desc' });
---
<Base einstellungen={einstellungen} jahre={jahre} title="Euer Auftritt bei Rock4Aid" noindex={true}>
  <section class="ba">
    <div class="ba-rahmen">
      <h1>Euer Auftritt bei Rock4Aid</h1>
      <p id="ba-kopf" class="ba-kopf">Einen Moment, wir laden eure Seite …</p>
      <div id="ba-intro" class="ba-intro" hidden>
        <p>Damit wir euch gut ankündigen können, brauchen wir ein paar Dinge von euch. Euer Pressefoto, euer Logo und ein kurzer Text über eure Band kommen auf unsere <strong>Plakate</strong>, auf die Website <strong>rock4aid.de</strong> und in unsere <strong>Social-Media-Beiträge</strong>. Hier könnt ihr alles hochladen.</p>
        <p id="ba-frist" class="ba-frist"></p>
      </div>
      <div id="ba-meldung" class="ba-meldung" hidden></div>

      <form id="ba-form" hidden novalidate>
        <fieldset class="ba-block">
          <legend>1. Pressefoto</legend>
          <p>Bitte ladet euer Pressefoto in der <strong>besten Qualität</strong> hoch, die ihr habt. Am besten ist die Originaldatei von eurer Fotografin oder eurem Fotografen. Fotos aus WhatsApp, Instagram oder von eurer Website sind meist verkleinert und reichen für ein großes Plakat nicht.</p>
          <p>Ihr müsst nichts nachmessen. Die Seite prüft beim Hochladen, ob das Foto groß genug ist. Möglich sind JPG- und PNG-Dateien bis 25 MB.</p>
          <div class="ba-datei">
            <input type="file" id="ba-foto" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
            <div id="ba-foto-info" class="ba-info"></div>
          </div>
        </fieldset>

        <fieldset class="ba-block">
          <legend>2. Fotografen-Credit</legend>
          <p>Wer hat das Pressefoto gemacht? Diesen Namen nennen wir überall, wo wir das Foto zeigen.</p>
          <input type="text" id="ba-credit" maxlength="120" placeholder="z. B. Foto: Anna Beispiel" />
        </fieldset>

        <fieldset class="ba-block">
          <legend>3. Nutzungsrechte</legend>
          <label class="ba-check">
            <input type="checkbox" id="ba-rechte" />
            <span id="ba-rechte-text"></span>
          </label>
          <p id="ba-rechte-stand" class="ba-klein"></p>
        </fieldset>

        <fieldset class="ba-block">
          <legend>4. Logo</legend>
          <p>Unsere Plakate sind sehr groß. Damit euer Logo darauf gestochen scharf aussieht, brauchen wir es in sehr hoher Auflösung.</p>
          <p>Am besten ist eine <strong>Vektordatei</strong> mit der Endung SVG, PDF, EPS oder AI. Sie hat keine feste Auflösung und bleibt deshalb in jeder Größe scharf. Wer euer Logo gestaltet hat, hat meist auch eine solche Datei.</p>
          <p>Wenn ihr keine Vektordatei habt, geht auch ein großes <strong>PNG mit transparentem Hintergrund</strong>. Ob es groß genug ist, prüft die Seite beim Hochladen für euch.</p>
          <div class="ba-datei">
            <input type="file" id="ba-logo" accept=".svg,.pdf,.eps,.ai,.png,image/svg+xml,application/pdf,application/postscript,image/png" />
            <div id="ba-logo-info" class="ba-info"></div>
          </div>
        </fieldset>

        <fieldset class="ba-block">
          <legend>5. Vorstellungstext</legend>
          <p>Stellt euch in <strong>1000 bis 1500 Zeichen</strong> vor. Leerzeichen und Zeilenumbrüche zählen mit, der Zähler unter dem Feld zeigt euch den Stand.</p>
          <p>Wir <strong>veröffentlichen euren Text auf unserer Website rock4aid.de</strong>. Dort erscheint er im Line-Up, wenn man auf euren Bandnamen klickt. Außerdem nutzen wir ihn für Ankündigungen in Social Media.</p>
          <textarea id="ba-text" rows="12" maxlength="2000"></textarea>
          <p id="ba-zaehler" class="ba-zaehler" aria-live="polite"></p>
        </fieldset>

        <fieldset class="ba-block">
          <legend>6. Website und Social Media</legend>
          <p>Wo findet man euch im Netz? Wir verlinken eure Kanäle auf rock4aid.de bei eurem Auftritt im Line-Up. Tragt nur ein, was ihr habt. Alle Felder sind freiwillig.</p>
          <div class="ba-links">
            <label>Website<input type="url" inputmode="url" data-plattform="website" placeholder="z. B. www.eure-band.de"></label>
            <label>Instagram<input type="url" inputmode="url" data-plattform="instagram" placeholder="z. B. instagram.com/euerband"></label>
            <label>Facebook<input type="url" inputmode="url" data-plattform="facebook" placeholder="z. B. facebook.com/euerband"></label>
            <label>YouTube<input type="url" inputmode="url" data-plattform="youtube" placeholder="z. B. youtube.com/@euerband"></label>
            <label>Spotify<input type="url" inputmode="url" data-plattform="spotify" placeholder="Link zu eurem Künstlerprofil"></label>
            <label>TikTok<input type="url" inputmode="url" data-plattform="tiktok" placeholder="z. B. tiktok.com/@euerband"></label>
            <label>Bandcamp<input type="url" inputmode="url" data-plattform="bandcamp" placeholder="z. B. euerband.bandcamp.com"></label>
          </div>
        </fieldset>

        <button type="submit" id="ba-senden" class="ba-knopf" disabled>Unterlagen senden</button>
        <p id="ba-fehlt" class="ba-klein"></p>
      </form>

      <div class="ba-datenschutz">
        <h2>Datenschutz</h2>
        <p>Wir speichern eure Dateien, euren Text, eure Links, den Fotografen-Credit und den Zeitpunkt eurer Rechtebestätigung. Wir nutzen sie nur, um euren Auftritt beim Rock4Aid-Festival anzukündigen. Die Daten liegen bei unserem Dienstleister Supabase und sind bis zur Freigabe nur für unser Orga-Team sichtbar. Wenn ihr nicht mehr beim Festival dabei seid, löschen wir eure Unterlagen auf Wunsch. Mehr steht in unserer <a href="/datenschutz/">Datenschutzerklärung</a>.</p>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* global, weil das Skript Vorschaubilder und Meldungen nachträglich einfügt */
  .ba { background:#ffdd00 url(/assets/grain.png) center/100% 100% no-repeat; color:#1d0f3a; padding:clamp(28px,5vw,64px) 0; }
  .ba-rahmen { max-width:820px; margin:0 auto; padding:0 max(16px, 5.66%); display:flex; flex-direction:column; gap:18px; }
  .ba h1 { margin:0; font-weight:700; font-size:clamp(28px,4.4vw,46px); line-height:1.08; color:#4b2e83; text-wrap:balance; }
  .ba h2 { margin:0 0 6px; font-size:20px; color:#4b2e83; }
  .ba p { margin:0; line-height:1.5; }
  .ba a { color:#4b2e83; text-decoration:underline; }
  .ba-kopf { font-size:18px; font-weight:600; }
  .ba-intro { display:flex; flex-direction:column; gap:10px; font-size:17px; }
  .ba-intro[hidden] { display:none; }
  .ba-frist { font-weight:600; }
  #ba-form { display:flex; flex-direction:column; gap:20px; }
  .ba-block { border:2px solid #4b2e83; border-radius:12px; background:#fff6c2; padding:18px 20px 20px; margin:0; display:flex; flex-direction:column; gap:10px; min-width:0; }
  /* Überschrift innerhalb des Kastens statt auf dem Rahmen */
  .ba-block legend { float:left; width:100%; padding:0; margin:0 0 2px; font-weight:700; font-size:20px; color:#4b2e83; }
  .ba-datei { display:flex; flex-direction:column; gap:8px; }
  .ba input[type=file] { font:inherit; max-width:100%; }
  .ba textarea, .ba input[type=text] { width:100%; font:inherit; font-size:16px; padding:10px 12px; border:2px solid #4b2e83; border-radius:8px; background:#fff; color:#1d0f3a; }
  .ba textarea { resize:vertical; line-height:1.5; }
  .ba-info { font-size:15px; line-height:1.45; }
  .ba-info img { display:block; width:auto; height:auto; max-width:220px; max-height:160px; object-fit:contain; border-radius:6px; margin-top:6px; background:repeating-conic-gradient(#ddd 0 25%, #fff 0 50%) 0 0/16px 16px; }
  .ba-ok { color:#1f6b2a; font-weight:600; }
  .ba-links { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:12px; }
  .ba-links label { display:flex; flex-direction:column; gap:4px; font-weight:600; font-size:15px; color:#4b2e83; min-width:0; }
  .ba-links input { width:100%; font:inherit; font-size:15px; font-weight:400; padding:9px 11px; border:2px solid #4b2e83; border-radius:8px; background:#fff; color:#1d0f3a; }
  .ba-weg { display:block; margin-top:8px; background:#fff; color:#a12020; border:2px solid #a12020; border-radius:8px; padding:6px 12px; font:inherit; font-size:14px; font-weight:600; cursor:pointer; }
  .ba-weg:hover { background:#fbebeb; }
  .ba-weg[disabled] { opacity:.5; cursor:default; }
  .ba-warn { color:#a12020; font-weight:600; }
  .ba-zaehler { font-weight:600; }
  .ba-check { display:flex; gap:10px; align-items:flex-start; line-height:1.5; cursor:pointer; }
  .ba-check input { width:22px; height:22px; flex:0 0 auto; margin-top:2px; accent-color:#4b2e83; }
  .ba-klein { font-size:14px; color:#3b2a5e; }
  .ba-knopf { align-self:flex-start; margin-top:8px; background:#4b2e83; color:#fff; border:0; border-radius:10px; padding:14px 24px; font:inherit; font-weight:700; font-size:18px; cursor:pointer; }
  .ba-knopf[disabled] { background:#9b8cb8; color:#f3eefb; cursor:not-allowed; }
  .ba-meldung { border-radius:10px; padding:14px 16px; font-weight:600; line-height:1.45; }
  .ba-meldung.ok { background:#e5f4e4; color:#1f6b2a; border:2px solid #1f6b2a; }
  .ba-meldung.fehler { background:#fbebeb; color:#a12020; border:2px solid #a12020; }
  .ba-balken { height:8px; background:#e6dcc0; border-radius:4px; overflow:hidden; }
  .ba-balken > div { height:100%; width:0; background:#4b2e83; transition:width .2s; }
  #ba-fehlt { margin-top:-8px; }
  .ba-datenschutz { font-size:14px; color:#3b2a5e; margin-top:16px; }
</style>

<script is:inline>
(() => {
  const API = '/.netlify/functions/band-abgabe';
  const MIN = 1000, MAX = 1500;
  const token = (location.pathname.match(/\/bands\/upload\/([a-f0-9]{64})\/?$/) || [])[1];
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const zeichen = (t) => [...String(t || '').replace(/\r\n?/g, '\n').trim()].length;
  const datum = (d) => new Date(d + 'T12:00:00').toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
  const zeit = (t) => new Date(t).toLocaleString('de-DE', { dateStyle: 'long', timeStyle: 'short' });
  const mb = (n) => (n / 1048576).toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' MB';
  const zustand = { foto: null, logo: null, vorhandenFoto: false, vorhandenLogo: false, offen: false, laeuft: false };

  function meldung(text, art) {
    const m = $('ba-meldung'); m.hidden = !text; m.className = 'ba-meldung ' + (art || ''); m.textContent = text || '';
    if (text) m.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  async function api(daten) {
    const r = await fetch(API, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token, ...daten }) });
    let d = {}; try { d = await r.json(); } catch { /* leer */ }
    if (!r.ok) throw new Error(d.fehler || 'Da ist etwas schiefgelaufen. Bitte versucht es gleich noch einmal.');
    return d;
  }

  // --- Dateien im Browser prüfen ---
  function bildMasse(file) {
    return new Promise((resolve) => {
      const img = new Image(); const url = URL.createObjectURL(file);
      img.onload = () => resolve({ w: img.naturalWidth, h: img.naturalHeight, img, url });
      img.onerror = () => resolve(null);
      img.src = url;
    });
  }
  function hatTransparenz(img) {
    const s = Math.min(1, 600 / img.naturalWidth);
    const c = document.createElement('canvas'); c.width = Math.max(1, Math.round(img.naturalWidth * s)); c.height = Math.max(1, Math.round(img.naturalHeight * s));
    const x = c.getContext('2d'); x.drawImage(img, 0, 0, c.width, c.height);
    const d = x.getImageData(0, 0, c.width, c.height).data;
    for (let i = 3; i < d.length; i += 4) if (d[i] < 250) return true;
    return false;
  }
  async function pruefeFoto(file) {
    const ext = file.name.split('.').pop().toLowerCase();
    if (!['jpg', 'jpeg', 'png'].includes(ext)) return { fehler: 'Das Pressefoto muss eine JPG- oder PNG-Datei sein.' };
    if (file.size > 25 * 1048576) return { fehler: `Das Foto ist ${mb(file.size)} groß. Erlaubt sind höchstens 25 MB.` };
    const m = await bildMasse(file);
    if (!m) return { fehler: 'Das Foto konnte nicht gelesen werden. Bitte prüft die Datei.' };
    const lang = Math.max(m.w, m.h);
    if (lang < 3000) return { fehler: `Dieses Foto ist für ein großes Plakat leider zu klein und würde unscharf. Bitte fragt eure Fotografin oder euren Fotografen nach der Originaldatei in voller Größe. (Technisch: ${m.w} × ${m.h} Pixel, wir brauchen mindestens 3000 an der langen Seite.)` };
    return { ok: `Passt. Das Foto ist groß genug für unsere Plakate.`, vorschau: m.url };
  }
  async function pruefeLogo(file) {
    const ext = file.name.split('.').pop().toLowerCase();
    if (file.size > 50 * 1048576) return { fehler: `Das Logo ist ${mb(file.size)} groß. Erlaubt sind höchstens 50 MB.` };
    if (['svg', 'pdf', 'eps', 'ai'].includes(ext)) return { ok: `Passt. Das ist eine Vektordatei, sie bleibt in jeder Größe scharf.`, vorschau: ext === 'svg' ? URL.createObjectURL(file) : null };
    if (ext !== 'png') return { fehler: 'Das Logo muss eine SVG-, PDF-, EPS- oder AI-Datei sein, notfalls ein PNG mit transparentem Hintergrund.' };
    const m = await bildMasse(file);
    if (!m) return { fehler: 'Das Logo konnte nicht gelesen werden. Bitte prüft die Datei.' };
    if (m.w < 5000) return { fehler: `Dieses Logo ist für ein großes Plakat leider zu klein und würde unscharf. Bitte fragt nach einer Vektordatei oder einer größeren Fassung. (Technisch: ${m.w} Pixel breit, wir brauchen mindestens 5000.)` };
    if (!hatTransparenz(m.img)) return { fehler: 'Das PNG-Logo hat keinen transparenten Hintergrund. Bitte ladet eine Fassung ohne Hintergrundfarbe hoch oder eine Vektordatei.' };
    return { ok: `Passt. Das Logo ist groß genug und hat einen transparenten Hintergrund. Eine Vektordatei wäre für das Plakat noch besser.`, vorschau: m.url };
  }
  function zeigeInfo(id, erg, file) {
    const el = $(id);
    if (erg.fehler) { el.innerHTML = `<span class="ba-warn">${esc(erg.fehler)}</span>`; return; }
    el.innerHTML = `<span class="ba-ok">${esc(file.name)}</span><br>${esc(erg.ok)}${erg.vorschau ? `<br><img src="${erg.vorschau}" alt="Vorschau">` : ''}`;
  }

  // --- Absenden-Knopf freigeben ---
  function pruefeAlles() {
    const n = zeichen($('ba-text').value);
    const z = $('ba-zaehler');
    z.textContent = n < MIN ? `${n} Zeichen. Es fehlen noch ${MIN - n} Zeichen.` : n > MAX ? `${n} Zeichen. Bitte kürzt um ${n - MAX} Zeichen.` : `${n} Zeichen. Passt.`;
    z.className = 'ba-zaehler ' + (n >= MIN && n <= MAX ? 'ba-ok' : 'ba-warn');
    const fehlt = [];
    if (!zustand.foto && !zustand.vorhandenFoto) fehlt.push('ein passendes Pressefoto');
    if (!$('ba-credit').value.trim()) fehlt.push('den Fotografen-Credit');
    if (!$('ba-rechte').checked) fehlt.push('die Bestätigung der Nutzungsrechte');
    if (!zustand.logo && !zustand.vorhandenLogo) fehlt.push('ein passendes Logo');
    if (n < MIN || n > MAX) fehlt.push('einen Text mit 1000 bis 1500 Zeichen');
    $('ba-senden').disabled = fehlt.length > 0 || !zustand.offen || zustand.laeuft;
    $('ba-fehlt').textContent = fehlt.length ? `Zum Senden brauchen wir noch ${fehlt.join(', ').replace(/, ([^,]*)$/, ' und $1')}.` : '';
  }

  // Bereits gesendete Datei anzeigen, mit Knopf zum Löschen
  function zeigeVorhanden(art) {
    const d = zustand.daten || {}; const info = $(`ba-${art}-info`); const v = d[art];
    info.innerHTML = '';
    if (!v) return;
    const zusatz = art === 'logo' ? `${v.art === 'vektor' ? 'Vektordatei' : 'PNG'}. ` : '';
    info.innerHTML = `<span class="ba-ok">Bereits gesendet: ${esc(v.name)}</span><br>${zusatz}Wenn ihr eine neue Datei wählt, ersetzt sie diese.${v.vorschau ? `<br><img src="${esc(v.vorschau)}" alt="${art === 'foto' ? 'Euer Pressefoto' : 'Euer Logo'}">` : ''}`;
    if (!zustand.offen) return;
    const weg = document.createElement('button'); weg.type = 'button'; weg.className = 'ba-weg';
    weg.textContent = art === 'foto' ? 'Dieses Foto löschen' : 'Dieses Logo löschen';
    weg.addEventListener('click', async () => {
      if (!window.confirm(art === 'foto' ? 'Wollt ihr das gesendete Pressefoto wirklich löschen? Danach braucht ihr ein neues Foto.' : 'Wollt ihr das gesendete Logo wirklich löschen? Danach braucht ihr ein neues Logo.')) return;
      weg.disabled = true;
      try { await api({ aktion: 'entfernen', art }); await laden(); meldung(art === 'foto' ? 'Das Pressefoto ist gelöscht. Bitte wählt ein neues Foto aus und sendet eure Unterlagen erneut.' : 'Das Logo ist gelöscht. Bitte wählt ein neues Logo aus und sendet eure Unterlagen erneut.', 'ok'); }
      catch (err) { meldung(err.message, 'fehler'); weg.disabled = false; }
    });
    info.appendChild(weg);
  }
  // Gewählte, noch nicht gesendete Datei wieder entfernen
  function auswahlKnopf(art) {
    const k = document.createElement('button'); k.type = 'button'; k.className = 'ba-weg';
    k.textContent = 'Auswahl entfernen';
    k.addEventListener('click', () => { $(`ba-${art}`).value = ''; zustand[art] = null; zeigeVorhanden(art); pruefeAlles(); });
    $(`ba-${art}-info`).appendChild(k);
  }
  async function dateiGewaehlt(art, e) {
    const f = e.target.files[0]; zustand[art] = null;
    if (!f) { zeigeVorhanden(art); pruefeAlles(); return; }
    $(`ba-${art}-info`).textContent = art === 'foto' ? 'Wir prüfen das Foto …' : 'Wir prüfen das Logo …';
    const erg = art === 'foto' ? await pruefeFoto(f) : await pruefeLogo(f);
    zeigeInfo(`ba-${art}-info`, erg, f); auswahlKnopf(art);
    if (!erg.fehler) zustand[art] = f;
    pruefeAlles();
  }
  $('ba-foto').addEventListener('change', (e) => dateiGewaehlt('foto', e));
  $('ba-logo').addEventListener('change', (e) => dateiGewaehlt('logo', e));
  ['ba-text', 'ba-credit', 'ba-rechte'].forEach((id) => $(id).addEventListener('input', pruefeAlles));
  $('ba-rechte').addEventListener('change', pruefeAlles);

  // --- Hochladen mit Fortschritt ---
  function hochladen(art, file, infoId) {
    return api({ aktion: 'upload', art, dateiname: file.name, groesse: file.size }).then((d) => new Promise((resolve, reject) => {
      const info = $(infoId);
      const balken = document.createElement('div'); balken.className = 'ba-balken'; balken.innerHTML = '<div></div>'; info.appendChild(balken);
      const xhr = new XMLHttpRequest();
      xhr.open('PUT', d.signedUrl);
      xhr.setRequestHeader('Content-Type', d.contentType);
      xhr.setRequestHeader('x-upsert', 'false');
      if (d.apikey) xhr.setRequestHeader('apikey', d.apikey);
      xhr.upload.onprogress = (ev) => { if (ev.lengthComputable) balken.firstChild.style.width = (100 * ev.loaded / ev.total) + '%'; };
      xhr.onload = () => (xhr.status >= 200 && xhr.status < 300 ? resolve(d.pfad) : reject(new Error('Das Hochladen hat nicht geklappt. Bitte versucht es noch einmal.')));
      xhr.onerror = () => reject(new Error('Das Hochladen hat nicht geklappt. Bitte prüft eure Internetverbindung.'));
      xhr.send(file);
    }));
  }

  $('ba-form').addEventListener('submit', async (e) => {
    e.preventDefault(); if ($('ba-senden').disabled) return;
    zustand.laeuft = true; pruefeAlles(); meldung('');
    $('ba-senden').textContent = 'Wird hochgeladen …';
    try {
      const fotoPfad = zustand.foto ? await hochladen('foto', zustand.foto, 'ba-foto-info') : null;
      const logoPfad = zustand.logo ? await hochladen('logo', zustand.logo, 'ba-logo-info') : null;
      await api({
        aktion: 'absenden', text: $('ba-text').value, credit: $('ba-credit').value, rechte: $('ba-rechte').checked,
        fotoPfad, logoPfad, fotoName: zustand.foto?.name, logoName: zustand.logo?.name,
        links: [...document.querySelectorAll('.ba-links input')].map((i) => ({ plattform: i.dataset.plattform, url: i.value.trim() })).filter((l) => l.url),
      });
      await laden();
      meldung('Vielen Dank! Eure Unterlagen sind bei uns angekommen. Bis zum Stichtag könnt ihr sie über diesen Link noch ändern.', 'ok');
    } catch (err) {
      meldung(err.message, 'fehler');
    } finally {
      zustand.laeuft = false; $('ba-senden').textContent = 'Unterlagen senden'; pruefeAlles();
    }
  });

  // --- Laden ---
  async function laden() {
    const d = await api({ aktion: 'laden' });
    zustand.offen = d.offen; zustand.foto = null; zustand.logo = null; zustand.daten = d;
    zustand.vorhandenFoto = !!d.foto; zustand.vorhandenLogo = !!d.logo;
    $('ba-foto').value = ''; $('ba-logo').value = '';
    $('ba-kopf').textContent = d.offen
      ? `Hallo ${d.band}! Schön, dass ihr beim Rock4Aid-Festival dabei seid.`
      : `Hallo ${d.band}! Der Stichtag war der ${datum(d.abgabeBis)}. Änderungen sind nicht mehr möglich. Wenn noch etwas fehlt, meldet euch bitte bei uns.`;
    $('ba-intro').hidden = !d.offen;
    $('ba-frist').textContent = `Bitte schickt uns alles bis zum ${datum(d.abgabeBis)}. Bis dahin könnt ihr eure Angaben über diesen Link jederzeit ändern.`;
    $('ba-rechte-text').textContent = d.rechteText;
    $('ba-text').value = d.text; $('ba-credit').value = d.credit;
    $('ba-rechte').checked = false;
    $('ba-rechte-stand').textContent = d.rechteBestaetigtAm ? `Zuletzt bestätigt am ${zeit(d.rechteBestaetigtAm)}. Bei jeder Änderung bestätigt ihr die Rechte erneut.` : '';
    zeigeVorhanden('foto'); zeigeVorhanden('logo');
    document.querySelectorAll('.ba-links input').forEach((i) => { i.value = ((d.links || []).find((l) => l.plattform === i.dataset.plattform) || {}).url || ''; });
    if (d.eingereichtAm && d.offen) meldung(`Eure Unterlagen vom ${zeit(d.eingereichtAm)} sind bei uns. Ihr könnt sie bis zum Stichtag noch ändern.`, 'ok');
    $('ba-form').querySelectorAll('input, textarea').forEach((el) => { el.disabled = !d.offen; });
    $('ba-form').hidden = false;
    pruefeAlles();
  }

  if (!token) { $('ba-kopf').textContent = 'Dieser Link ist unvollständig. Bitte nutzt genau den Link, den ihr von uns bekommen habt.'; return; }
  laden().catch((err) => { $('ba-kopf').textContent = err.message; });
})();
</script>
