---
import Base from '../layouts/Base.astro';
import { getTable } from '../lib/content.js';

const einstellungen = await getTable('einstellungen', { single: true });
const jahre = await getTable('rueckblick_jahre', { order: 'reihenfolge.desc' });
const u = await getTable('ueber_uns', { single: true });
const abschnitte = (await getTable('ueber_uns_abschnitte', { order: 'reihenfolge.asc' }))
  .filter((a) => a.sichtbar !== false);
const hidden = einstellungen.ueberuns_sichtbar === false || u.sichtbar === false;
// Abwechselnd gelb/weiß, damit die Seite ohne weitere Gestaltung lebendig wirkt
const bg = (i) => (i % 2 === 0 ? '#ffdd00 url(/assets/grain.png) center/100% 100% no-repeat' : '#fff');
---
<Base active="ueberuns" einstellungen={einstellungen} jahre={jahre} title="Über uns – Rock4Aid" noindex={hidden}>
  {hidden ? (
    <section style="background:#4b2e83;padding:clamp(60px,10vw,140px) 5.66%;text-align:center;min-height:40vh">
      <p style="font-family:'Archivo',sans-serif;font-weight:600;font-size:clamp(18px,2.6vw,30px);color:#fff">Diese Seite ist derzeit nicht veröffentlicht.</p>
    </section>
  ) : (
    <>
      <section class="uu-hero" style="position:relative;background:#4b2e83;overflow:hidden;min-height:min(30vw,420px)">
        {u.hero_bild && <img class="r4a-anim" src={u.hero_bild} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;animation:r4aPan 30s ease-in-out infinite;will-change:transform" />}
        {u.hero_bild && <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(18,10,32,.62) 0%,rgba(18,10,32,.4) 45%,rgba(18,10,32,.55) 100%)"></div>}
        <div style="position:relative;min-height:min(30vw,420px);max-width:1500px;margin:0 auto;padding:clamp(34px,5.2vw,64px) 5.66% clamp(40px,6vw,80px);display:flex;flex-direction:column">
          <h1 style="margin:0;text-align:center;font-family:'Archivo',sans-serif;font-weight:700;font-size:clamp(28px,4.88vw,50px);line-height:1;letter-spacing:-.013em;color:#fff;text-wrap:balance">{u.hero_titel || 'Über uns'}</h1>
          <div style="width:100%;height:2px;background:rgba(255,255,255,.9);margin:clamp(12px,1.8vw,22px) 0 0"></div>
          {u.intro_text && <div style="margin:auto auto;max-width:min(74%,840px);text-align:center;font-family:'Archivo',sans-serif;font-weight:400;font-size:clamp(17px,1.9vw,23px);line-height:1.55;letter-spacing:.01em;color:#fff;text-wrap:pretty;padding-top:clamp(16px,2.4vw,30px)" set:html={u.intro_text}></div>}
        </div>
      </section>

      {abschnitte.map((a, i) => (
        <section style={`background:${bg(i)};padding:clamp(30px,4.8vw,72px) 0 clamp(36px,5.5vw,82px)`}>
          <div style="max-width:1500px;margin:0 auto;padding:0 5.66%">
            {a.titel && <h2 style="margin:0;text-align:center;font-family:'Archivo',sans-serif;font-weight:700;font-size:clamp(26px,4.2vw,44px);line-height:1.05;letter-spacing:-.013em;color:#4b2e83;text-wrap:balance">{a.titel}</h2>}
            {a.titel && <div style="width:100%;height:2px;background:#4b2e83;margin:clamp(12px,1.8vw,22px) 0 0"></div>}
            <div style={`margin:clamp(24px,3.8vw,50px) 0 0;display:flex;flex-wrap:wrap;gap:clamp(22px,4vw,60px);align-items:center;flex-direction:${a.bild_rechts ? 'row-reverse' : 'row'}`}>
              {a.bild && <img src={a.bild} alt="" loading="lazy" style="flex:1 1 40%;min-width:260px;width:100%;height:auto;max-height:560px;object-fit:contain" />}
              <div class="uu-text" style={`flex:1 1 ${a.bild ? '44%' : '100%'};min-width:280px;display:flex;flex-direction:column;gap:.9em;text-align:left;font-family:'Archivo',sans-serif;font-weight:400;font-size:clamp(16px,1.6vw,20px);line-height:1.6;letter-spacing:.01em;color:#4b2e83;text-wrap:pretty`} set:html={a.text}></div>
            </div>
          </div>
        </section>
      ))}
    </>
  )}
  <style>
    .uu-text :global(p) { margin:0; }
    .uu-text :global(a) { color:inherit; font-weight:600; text-decoration:underline; text-underline-offset:.15em; }
    .uu-text :global(ul) { margin:0; padding-left:1.2em; }
    @media (max-width:640px) {
      .uu-hero { min-height:40vh !important; }
    }
  </style>
</Base>
