---
import Base from '../layouts/Base.astro';
import TextFluss from '../components/TextFluss.astro';
import SprungNavi from '../components/SprungNavi.astro';
import { anker } from '../lib/textbild.js';
import { getTable } from '../lib/content.js';

const einstellungen = await getTable('einstellungen', { single: true });
const jahre = await getTable('rueckblick_jahre', { order: 'reihenfolge.desc' });
const u = await getTable('ueber_uns', { single: true });
const abschnitte = (await getTable('ueber_uns_abschnitte', { order: 'reihenfolge.asc' }))
  .filter((a) => a.sichtbar !== false);
const navi = [
  { id: 'start', label: u.nav_titel || 'Das Festival' },
  ...abschnitte.filter((a) => a.kurztitel).map((a) => ({ id: anker(a.kurztitel), label: a.kurztitel })),
];
const hidden = einstellungen.ueberuns_sichtbar === false || u.sichtbar === false;
---
<Base active="ueberuns" einstellungen={einstellungen} jahre={jahre} title="Über uns – Rock4Aid" noindex={hidden}>
  {hidden ? (
    <section style="background:#4b2e83;padding:clamp(60px,10vw,140px) 5.66%;text-align:center;min-height:40vh">
      <p style="font-family:'Archivo',sans-serif;font-weight:600;font-size:clamp(18px,2.6vw,30px);color:#fff">Diese Seite ist derzeit nicht veröffentlicht.</p>
    </section>
  ) : (
    <>
      <SprungNavi eintraege={navi} />
      <section id="start" data-sprungziel class="uu-hero" style="position:relative;background:#4b2e83;overflow:hidden">
        {u.hero_bild && <img class="r4a-anim" src={u.hero_bild} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;animation:r4aPan 30s ease-in-out infinite;will-change:transform" />}
        {u.hero_bild && <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(18,10,32,.5) 0%,rgba(18,10,32,.38) 50%,rgba(18,10,32,.5) 100%)"></div>}
        <div style="position:relative;max-width:1500px;margin:0 auto;padding:clamp(22px,3.2vw,40px) 5.66% clamp(40px,6vw,80px)">
          <h1 style="margin:0;text-align:center;font-family:'Archivo',sans-serif;font-weight:700;font-size:clamp(28px,4.88vw,50px);line-height:1;letter-spacing:-.013em;color:#fff;text-wrap:balance">{u.hero_titel || 'Über uns'}</h1>
          <div style="width:100%;height:2px;background:rgba(255,255,255,.9);margin:clamp(12px,1.8vw,22px) 0 0"></div>
          {u.intro_text && <div class="uu-hero-text" set:html={u.intro_text}></div>}
        </div>
      </section>

      <TextFluss abschnitte={abschnitte} />
    </>
  )}
  <style>
    .uu-hero-text { max-width:760px; margin:clamp(10px,1.6vw,20px) auto 0; padding:clamp(10px,2vw,24px) 0; display:flex; flex-direction:column; gap:.9em; font-family:'Archivo',sans-serif; font-size:clamp(16px,1.6vw,20px); line-height:1.6; letter-spacing:.01em; color:#fff; text-align:justify; hyphens:auto; -webkit-hyphens:auto; }
    .uu-hero-text { position:relative; isolation:isolate; }
    .uu-hero-text::before { content:''; position:absolute; inset:-28px -110px; z-index:-1; background:rgba(30,16,58,.55); -webkit-backdrop-filter:blur(2px); backdrop-filter:blur(2px);
      -webkit-mask-image:linear-gradient(90deg,transparent 0,#000 120px,#000 calc(100% - 120px),transparent 100%),linear-gradient(180deg,transparent 0,#000 40px,#000 calc(100% - 40px),transparent 100%);
      -webkit-mask-composite:source-in; mask-image:linear-gradient(90deg,transparent 0,#000 120px,#000 calc(100% - 120px),transparent 100%),linear-gradient(180deg,transparent 0,#000 40px,#000 calc(100% - 40px),transparent 100%); mask-composite:intersect; }
    @media (max-width:760px) { .uu-hero-text::before { inset:-16px -16px; -webkit-mask-image:linear-gradient(90deg,transparent 0,#000 16px,#000 calc(100% - 16px),transparent 100%),linear-gradient(180deg,transparent 0,#000 24px,#000 calc(100% - 24px),transparent 100%); mask-image:linear-gradient(90deg,transparent 0,#000 16px,#000 calc(100% - 16px),transparent 100%),linear-gradient(180deg,transparent 0,#000 24px,#000 calc(100% - 24px),transparent 100%); } }
    .uu-hero-text :global(p) { margin:0; }
    .uu-hero-text :global(p:first-child) { font-size:1.12em; }
    .uu-hero-text :global(ul) { margin:0; padding-left:1.2em; display:flex; flex-direction:column; gap:.5em; }
    @media (max-width:640px) { .uu-hero-text { text-align:left; } }
    .uu-hero-text :global(a) { color:inherit; font-weight:600; text-decoration:underline; }
  </style>
</Base>
