---
// Kleine Link-Buttons je Band/Act. links: [{ plattform, url }]
const { links = [], mt = '.5em', justify = 'flex-start' } = Astro.props;
const list = Array.isArray(links) ? links.filter((l) => l && l.url) : [];
const LABEL = {
  instagram: 'Instagram', facebook: 'Facebook', youtube: 'YouTube',
  website: 'Website', spotify: 'Spotify', tiktok: 'TikTok', bandcamp: 'Bandcamp',
};
---
{list.length > 0 && (
  <div style={`display:flex;flex-wrap:wrap;justify-content:${justify};gap:8px;margin:${mt} 0 0`}>
    {list.map((l) => (
      <a href={l.url} target="_blank" rel="noopener noreferrer" class="r4a-link"
         style="display:inline-flex;align-items:center;gap:6px;background:rgba(75,46,131,.10);color:#4b2e83;font-family:'Archivo',sans-serif;font-weight:600;font-size:12.5px;line-height:1;padding:5px 11px;border-radius:999px;white-space:nowrap;text-decoration:none;border:1px solid rgba(75,46,131,.32)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="opacity:.75"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
        <span>{LABEL[(l.plattform || '').toLowerCase()] || l.plattform || 'Link'}</span>
        <span aria-hidden="true" style="opacity:.6">↗</span>
      </a>
    ))}
  </div>
)}
<style>
  .r4a-link { transition: background .15s ease, border-color .15s ease; }
  .r4a-link:hover { background:rgba(75,46,131,.18); border-color:rgba(75,46,131,.5); }
</style>
