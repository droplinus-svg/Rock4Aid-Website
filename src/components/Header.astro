---
const { active = '', activeSlug = '', einstellungen = {}, jahre = [] } = Astro.props;
const s = einstellungen || {};
const col = (key) => (active === key ? '#ffdd00' : '#fff');
const terminHref = active === 'termin' ? '#start' : '/#start';
const visYears = (jahre || []).filter((j) => j.sichtbar !== false);
// Rückblicke nach Jahr gruppieren, neuestes Jahr oben. Innerhalb eines Jahres
// steht die höhere "reihenfolge" oben (z. B. Festival vor Seewandel).
const rbGruppen = [...new Set(visYears.map((j) => Number(j.jahr)))]
  .sort((a, b) => b - a)
  .map((jahr) => ({
    jahr,
    eintraege: visYears.filter((j) => Number(j.jahr) === jahr)
      .sort((a, b) => (b.reihenfolge ?? 0) - (a.reihenfolge ?? 0)),
  }));
const showLineup = s.lineup_sichtbar !== false;
const showCharity = s.charity_sichtbar !== false;
const showAnfahrt = s.anfahrt_sichtbar !== false;
const showUeberUns = s.ueberuns_sichtbar !== false;
const showMitglied = s.mitglied_sichtbar !== false;
// Die Helferseite (/helfer/) steht bewusst nicht im Menü, damit die Kopfzeile
// übersichtlich bleibt. Der Weg dorthin führt über die Kontaktseite.
---
<header style="position:fixed;top:0;left:0;right:0;z-index:80;background:rgba(75,46,131,.96);backdrop-filter:blur(8px);box-shadow:0 2px 14px rgba(20,10,45,.35)">
  <div style="padding:7px 5.1%;display:flex;align-items:center;justify-content:space-between;gap:18px">
    <a href="/" aria-label="Rock4Aid – zur Startseite" style="flex:0 0 auto;line-height:0">
      <img src="/assets/wordmark.png" alt="Rock4Aid" style="width:clamp(88px,9vw,124px);height:auto" />
    </a>
    <input type="checkbox" id="r4a-burger-cb" class="r4a-burger-cb" />
    <label class="r4a-burger-btn" for="r4a-burger-cb" aria-label="Menü öffnen/schließen">
      <svg width="27" height="27" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </label>
    <nav class="r4a-nav" style="display:flex;align-items:center;gap:clamp(9px,1.5vw,22px);flex-wrap:wrap;justify-content:flex-end;font-family:'Archivo',sans-serif;font-weight:600;font-size:13px;line-height:1">
      <a href={terminHref} style={`color:${col('termin')};padding:4px 0;white-space:nowrap`}>Termin</a>
      {showLineup && <a href="/line-up/" style={`color:${col('lineup')};padding:4px 0;white-space:nowrap`}>Line-Up</a>}
      {showCharity && <a href="/charity/" style={`color:${col('charity')};padding:4px 0;white-space:nowrap`}>Charity</a>}
      {showAnfahrt && <a href="/anfahrt-kontakt/" style={`color:${col('anfahrt')};padding:4px 0;white-space:nowrap`}>Anfahrt & Kontakt</a>}
      {showUeberUns && <a href="/ueber-uns/" style={`color:${col('ueberuns')};padding:4px 0;white-space:nowrap`}>Über uns</a>}
      {showMitglied && <a href="/mitglied-werden/" style={`color:${col('mitglied')};padding:4px 0;white-space:nowrap`}>Mitglied werden</a>}
      {visYears.length > 0 && (
        <details class="r4a-rueck" style="position:relative">
          <summary style={`cursor:pointer;color:${col('rueckblick')};padding:4px 0;white-space:nowrap;display:flex;align-items:center;gap:5px`}>Rückblick<span style="font-size:9px;line-height:1">▼</span></summary>
          <div class="r4a-drop" style="position:absolute;top:calc(100% + 10px);right:0;min-width:190px;background:#3d2569;border:1px solid rgba(255,255,255,.22);display:flex;flex-direction:column;box-shadow:0 10px 24px rgba(20,10,45,.5);padding:4px 0 8px">
            {rbGruppen.map((g, gi) => (
              <div class="r4a-gruppe" style={gi > 0 ? 'border-top:1px solid rgba(255,255,255,.14);margin-top:4px' : ''}>
                <div class="r4a-jahr" style="padding:12px 16px 4px;color:rgba(255,255,255,.6);font-size:12px;font-weight:600;letter-spacing:.06em">{g.jahr}</div>
                {g.eintraege.map((j) => (
                  <a href={`/${j.slug}/`} style={`display:block;color:${activeSlug === j.slug ? '#ffdd00' : '#fff'};padding:8px 16px 8px 26px`}>{j.veranstaltung || j.titel}</a>
                ))}
              </div>
            ))}
          </div>
        </details>
      )}
    </nav>
  </div>
</header>
<style>
  /* Burger-Menü nur auf dem Handy – Desktop bleibt die normale Leiste */
  .r4a-burger-cb { display:none; }
  .r4a-burger-btn { display:none; }
  @media (max-width:640px) {
    .r4a-burger-btn { display:inline-flex; align-items:center; justify-content:center; width:42px; height:42px; margin:-4px -6px -4px 0; cursor:pointer; flex:0 0 auto; -webkit-tap-highlight-color:transparent; }
    .r4a-nav {
      display:none !important;
      position:absolute; top:100%; left:0; right:0;
      flex-direction:column !important; align-items:stretch !important;
      background:#3d2569; padding:4px 5.1% 12px !important; gap:0 !important;
      box-shadow:0 14px 26px rgba(20,10,45,.5);
      font-size:16px !important;
    }
    .r4a-burger-cb:checked ~ .r4a-nav { display:flex !important; }
    .r4a-nav > a, .r4a-nav > .r4a-rueck > summary {
      padding:14px 2px !important; font-size:16px !important;
      border-bottom:1px solid rgba(255,255,255,.12);
    }
    .r4a-nav > .r4a-rueck { position:static !important; }
    .r4a-nav .r4a-drop {
      position:static !important; border:none !important; box-shadow:none !important;
      min-width:0 !important; background:transparent !important; padding:0 0 0 14px !important;
    }
    .r4a-nav .r4a-drop a { padding:10px 2px 10px 12px !important; border-bottom:none !important; }
    .r4a-nav .r4a-jahr { padding:12px 2px 2px !important; }
    .r4a-nav .r4a-gruppe { border-top:none !important; margin-top:0 !important; }
  }
</style>
