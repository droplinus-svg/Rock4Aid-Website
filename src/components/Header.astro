---
const { active = '', activeSlug = '', einstellungen = {}, jahre = [] } = Astro.props;
const s = einstellungen || {};
const col = (key) => (active === key ? '#ffdd00' : '#fff');
const terminHref = active === 'termin' ? '#start' : 'index.html#start';
const visYears = (jahre || []).filter((j) => j.sichtbar !== false)
  .sort((a, b) => (b.reihenfolge ?? b.jahr ?? 0) - (a.reihenfolge ?? a.jahr ?? 0));
const showLineup = s.lineup_sichtbar !== false;
const showCharity = s.charity_sichtbar !== false;
const showAnfahrt = s.anfahrt_sichtbar !== false;
---
<header style="position:fixed;top:0;left:0;right:0;z-index:80;background:rgba(75,46,131,.96);backdrop-filter:blur(8px);box-shadow:0 2px 14px rgba(20,10,45,.35)">
  <div style="max-width:1500px;margin:0 auto;padding:7px clamp(14px,2.4vw,32px);display:flex;align-items:center;justify-content:space-between;gap:18px">
    <a href="index.html" aria-label="Rock4Aid – zur Startseite" style="flex:0 0 auto;line-height:0">
      <img src="/assets/wordmark.png" alt="Rock4Aid" style="width:clamp(88px,9vw,124px);height:auto" />
    </a>
    <nav class="r4a-nav" style="display:flex;align-items:center;gap:clamp(9px,1.5vw,22px);flex-wrap:wrap;justify-content:flex-end;font-family:'Archivo',sans-serif;font-weight:600;font-size:13px;line-height:1">
      <a href={terminHref} style={`color:${col('termin')};padding:4px 0;white-space:nowrap`}>Termin</a>
      {showLineup && <a href="line-up.html" style={`color:${col('lineup')};padding:4px 0;white-space:nowrap`}>Line-Up</a>}
      {showCharity && <a href="charity.html" style={`color:${col('charity')};padding:4px 0;white-space:nowrap`}>Charity</a>}
      {showAnfahrt && <a href="anfahrt-kontakt.html" style={`color:${col('anfahrt')};padding:4px 0;white-space:nowrap`}>Anfahrt & Kontakt</a>}
      {visYears.length > 0 && (
        <details style="position:relative">
          <summary style={`cursor:pointer;color:${col('rueckblick')};padding:4px 0;white-space:nowrap;display:flex;align-items:center;gap:5px`}>Rückblick<span style="font-size:9px;line-height:1">▼</span></summary>
          <div class="r4a-drop" style="position:absolute;top:calc(100% + 10px);right:0;min-width:172px;background:#3d2569;border:1px solid rgba(255,255,255,.22);display:flex;flex-direction:column;box-shadow:0 10px 24px rgba(20,10,45,.5)">
            {visYears.map((j, i) => (
              <a href={`${j.slug}.html`} style={`color:${activeSlug === j.slug ? '#ffdd00' : '#fff'};padding:12px 16px;${i < visYears.length - 1 ? 'border-bottom:1px solid rgba(255,255,255,.14)' : ''}`}>{j.titel}</a>
            ))}
          </div>
        </details>
      )}
    </nav>
  </div>
</header>
