---
const { einstellungen = {} } = Astro.props;
const jahr = (einstellungen && einstellungen.festival_jahr) || '2027';
// Sichtbarer "Stand"-Marker: bestätigt, dass der aktuelle Datei-Stand live ist.
// SITE_VERSION wird bei jeder Lieferung hochgezählt; BUILD_TS setzt Netlify beim Build automatisch.
const SITE_VERSION = 'v12';
const BUILD_TS = new Date().toLocaleString('de-DE', { timeZone: 'Europe/Berlin', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
---
<footer class="r4a-footer" style="background:#3d2569;padding:26px 5.1%">
  <div style="display:flex;flex-wrap:wrap;gap:18px;align-items:center;justify-content:space-between">
    <span style="font-family:'Archivo',sans-serif;font-size:15px;color:rgba(255,255,255,.7)">© {jahr} Rock4Aid · Benefiz-Festival Heddesheim</span>
    <span class="r4a-legal" style="display:flex;gap:20px;font-family:'Archivo',sans-serif;font-weight:700;font-size:15px;letter-spacing:.08em;text-transform:uppercase">
      <a href="/impressum/" style="color:#fff">Impressum</a>
      <a href="/datenschutz/" style="color:#fff">Datenschutz</a>
    </span>
  </div>
  <div class="r4a-stand" style="margin-top:12px;font-family:'Archivo',sans-serif;font-size:11px;letter-spacing:.02em;color:rgba(255,255,255,.30)">Stand {SITE_VERSION} · gebaut {BUILD_TS}</div>
</footer>
<style>
  /* Mobil: Impressum/Datenschutz oben, Copyright darunter, lockerer; Versionsnummer aus */
  @media (max-width:640px) {
    .r4a-footer { padding:13px 5.1% 15px !important; background:#4b2e83 !important; }
    .r4a-footer > div { flex-direction:column-reverse !important; align-items:flex-start !important; gap:7px !important; }
    .r4a-footer span { font-size:11.5px !important; gap:16px !important; line-height:1.3 !important; }
    /* Impressum/Datenschutz mobil zurückhaltender: nicht gesperrt, nicht fett, etwas grauer */
    .r4a-legal { font-weight:400 !important; letter-spacing:0 !important; text-transform:none !important; }
    .r4a-legal a { color:rgba(255,255,255,.5) !important; }
    .r4a-stand { display:none !important; }
  }
</style>
