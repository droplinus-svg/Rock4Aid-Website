---
// Alle Abschnitte als ein zusammenhängender Text auf gelbem Grund.
// Die Textspalte ist schmal, zentriert und liegt auf einem hellen Kasten,
// damit sie gut lesbar ist. Bilder stehen zwischen den Absätzen.
import { teileText, anker } from '../lib/textbild.js';
const { abschnitte = [] } = Astro.props;
const bloecke = abschnitte.map((a) => {
  const [vor, nach] = a.bild ? teileText(a.text, a.bild_nach_absatz ?? 1) : [a.text || '', ''];
  return { ...a, vor, nach, id: a.kurztitel ? anker(a.kurztitel) : undefined };
});
// Aufeinanderfolgende Abschnitte mit gleichem Hintergrund bilden einen Bereich.
const bereiche = [];
for (const b of bloecke) {
  const farbe = b.hintergrund === 'weiss' ? 'weiss' : (b.hintergrund === 'bild' && b.hintergrund_bild ? 'bild' : 'gelb');
  const letzter = bereiche[bereiche.length - 1];
  // Foto-Abschnitte stehen immer für sich, weil jeder sein eigenes Bild hat
  if (letzter && letzter.farbe === farbe && farbe !== 'bild') letzter.bloecke.push(b);
  else bereiche.push({ farbe, bild: farbe === 'bild' ? b.hintergrund_bild : null, bloecke: [b] });
}
---
{bereiche.map((ber) => (
  <section class={`tf-grund tf-${ber.farbe}`} data-band={ber.farbe}>
    {ber.bild && <img class="tf-foto" src={ber.bild} alt="" loading="lazy" />}
    {ber.bild && <div class="tf-foto-dunkel"></div>}
    <div class="tf-kasten">
      {ber.bloecke.map((a) => (
        <div class="tf-block" id={a.id} data-sprungziel={a.id ? '' : undefined}>
          {a.titel && <h2 class="tf-h2">{a.titel}</h2>}
          <div class="tf-text">
            <Fragment set:html={a.vor} />
            {a.bild && <img class="tf-inbild" src={a.bild} alt="" loading="lazy" />}
            {a.nach && <Fragment set:html={a.nach} />}
          </div>
        </div>
      ))}
    </div>
  </section>
))}
<style>
  .tf-grund { background:#ffdd00 url(/assets/grain.png) center/cover no-repeat; padding:clamp(14px,2vw,28px) 5.66% clamp(18px,2.4vw,32px); overflow:hidden; }
  /* Weiße Bereiche: gleiche Spalte, ohne Aufhellung und mit etwas mehr Luft */
  .tf-weiss { background:#fff; padding-top:clamp(26px,3.6vw,48px); padding-bottom:clamp(30px,4vw,54px); }
  .tf-weiss .tf-kasten::before { display:none; }
  /* Foto-Bereiche: Text liegt hell auf einem abgedunkelten Foto, wie im Titelbild */
  .tf-grund.tf-bild { position:relative; background:#2e1a52; padding-top:clamp(40px,6vw,90px); padding-bottom:clamp(44px,6.5vw,96px); }
  .tf-foto { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .tf-foto-dunkel { position:absolute; inset:0; background:linear-gradient(180deg,rgba(18,10,32,.34) 0%,rgba(18,10,32,.22) 50%,rgba(18,10,32,.4) 100%); }
  .tf-grund.tf-bild .tf-kasten::before { background:rgba(30,16,58,.55); -webkit-backdrop-filter:blur(2px); backdrop-filter:blur(2px); }
  .tf-grund.tf-bild .tf-h2 { color:#fff; }
  .tf-grund.tf-bild .tf-text { color:#fff; }
  .tf-grund.tf-bild .tf-text :global(a) { color:#ffdd00; }
  .tf-kasten { max-width:760px; margin:0 auto; padding:clamp(10px,2vw,24px) 0; }
  .tf-kasten { position:relative; isolation:isolate; }
  .tf-kasten::before { content:''; position:absolute; inset:-28px -110px; z-index:-1; background:rgba(255,240,140,.6);
    -webkit-mask-image:linear-gradient(90deg,transparent 0,#000 120px,#000 calc(100% - 120px),transparent 100%),linear-gradient(180deg,transparent 0,#000 40px,#000 calc(100% - 40px),transparent 100%);
    -webkit-mask-composite:source-in; mask-image:linear-gradient(90deg,transparent 0,#000 120px,#000 calc(100% - 120px),transparent 100%),linear-gradient(180deg,transparent 0,#000 40px,#000 calc(100% - 40px),transparent 100%); mask-composite:intersect; }
  @media (max-width:760px) { .tf-kasten::before { inset:-16px -16px; -webkit-mask-image:linear-gradient(90deg,transparent 0,#000 16px,#000 calc(100% - 16px),transparent 100%),linear-gradient(180deg,transparent 0,#000 24px,#000 calc(100% - 24px),transparent 100%); mask-image:linear-gradient(90deg,transparent 0,#000 16px,#000 calc(100% - 16px),transparent 100%),linear-gradient(180deg,transparent 0,#000 24px,#000 calc(100% - 24px),transparent 100%); } }
  .tf-block + .tf-block { margin-top:clamp(22px,2.8vw,32px); }
  .tf-h2 { margin:0 0 .55em; font-family:'Archivo',sans-serif; font-weight:700; font-size:clamp(20px,2.3vw,27px); line-height:1.2; color:#4b2e83; text-wrap:balance; }
  .tf-text { display:flex; flex-direction:column; gap:.85em; font-family:'Archivo',sans-serif; font-size:clamp(16px,1.5vw,19px); line-height:1.6; letter-spacing:.01em; color:#231040; text-align:justify; hyphens:auto; -webkit-hyphens:auto; }
  .tf-text :global(p) { margin:0; }
  .tf-text :global(ul) { margin:0; padding-left:1.2em; display:flex; flex-direction:column; gap:.45em; }
  .tf-text :global(a) { color:#4b2e83; font-weight:600; text-decoration:underline; text-underline-offset:.15em; }
  /* Auf schmalen Bildschirmen erzeugt Blocksatz große Lücken, dort linksbündig */
  @media (max-width:640px) { .tf-text { text-align:left; } }
  .tf-inbild { display:block; width:100%; height:auto; margin:.4em 0; border-radius:8px; }
</style>
