---
// Alle Abschnitte als ein zusammenhängender Text auf gelbem Grund.
// Die Textspalte ist schmal, zentriert und liegt auf einem hellen Kasten,
// damit sie gut lesbar ist. Bilder stehen zwischen den Absätzen.
import { teileText } from '../lib/textbild.js';
const { abschnitte = [] } = Astro.props;
const bloecke = abschnitte.map((a) => {
  const [vor, nach] = a.bild ? teileText(a.text, a.bild_nach_absatz ?? 1) : [a.text || '', ''];
  return { ...a, vor, nach };
});
---
{bloecke.length > 0 && (
  <section class="tf-grund">
    <div class="tf-kasten">
      {bloecke.map((a) => (
        <div class="tf-block">
          {a.titel && <h2 class="tf-h2">{a.titel}</h2>}
          <div class="tf-text">
            <Fragment set:html={a.vor} />
            {a.bild && <img class="tf-bild" src={a.bild} alt="" loading="lazy" />}
            {a.nach && <Fragment set:html={a.nach} />}
          </div>
        </div>
      ))}
    </div>
  </section>
)}
<style>
  .tf-grund { background:#ffdd00 url(/assets/grain.png) center/cover no-repeat; padding:clamp(24px,4vw,56px) 4%; }
  .tf-kasten { max-width:760px; margin:0 auto; background:rgba(255,255,255,.55); border-radius:14px; padding:clamp(22px,4vw,48px) clamp(18px,4vw,52px); }
  .tf-block + .tf-block { margin-top:clamp(22px,2.8vw,32px); }
  .tf-h2 { margin:0 0 .55em; font-family:'Archivo',sans-serif; font-weight:700; font-size:clamp(20px,2.3vw,27px); line-height:1.2; color:#4b2e83; text-wrap:balance; }
  .tf-text { display:flex; flex-direction:column; gap:.85em; font-family:'Archivo',sans-serif; font-size:clamp(16px,1.5vw,19px); line-height:1.6; letter-spacing:.01em; color:#2e1a52; text-align:justify; hyphens:auto; -webkit-hyphens:auto; }
  .tf-text :global(p) { margin:0; }
  .tf-text :global(ul) { margin:0; padding-left:1.2em; display:flex; flex-direction:column; gap:.45em; }
  .tf-text :global(a) { color:#4b2e83; font-weight:600; text-decoration:underline; text-underline-offset:.15em; }
  /* Auf schmalen Bildschirmen erzeugt Blocksatz große Lücken, dort linksbündig */
  @media (max-width:640px) { .tf-text { text-align:left; } }
  .tf-bild { display:block; width:100%; height:auto; margin:.4em 0; border-radius:8px; }
</style>
