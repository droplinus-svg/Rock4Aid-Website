---
// Leiste mit Sprungmarken direkt unter dem Seitenkopf. Sie bleibt beim Scrollen
// stehen und markiert den Abschnitt, in dem sich der Leser gerade befindet.
const { eintraege = [] } = Astro.props; // [{ id, label }]
---
{eintraege.length > 1 && (
  <nav class="sn" aria-label="Abschnitte dieser Seite">
    <div class="sn-innen">
      {eintraege.map((e) => <a class="sn-link" href={`#${e.id}`} data-ziel={e.id}>{e.label}</a>)}
    </div>
  </nav>
)}
<style>
  .sn { position:sticky; top:52px; z-index:70; background:rgba(46,26,82,.94); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); border-top:1px solid rgba(255,255,255,.12); box-shadow:0 2px 10px rgba(20,10,45,.25); }
  .sn-innen { max-width:1500px; margin:0 auto; padding:9px 5.66%; display:flex; gap:8px; justify-content:center; overflow-x:auto; scrollbar-width:none; }
  .sn-innen::-webkit-scrollbar { display:none; }
  .sn-link { flex:0 0 auto; font-family:'Archivo',sans-serif; font-weight:600; font-size:14px; line-height:1; color:#fff; text-decoration:none; padding:8px 14px; border-radius:999px; border:1px solid rgba(255,255,255,.35); white-space:nowrap; transition:background .15s,color .15s; }
  .sn-link:hover { background:rgba(255,255,255,.14); }
  .sn-link.aktiv { background:#ffdd00; border-color:#ffdd00; color:#4b2e83; }
  @media (max-width:760px) { .sn-innen { justify-content:flex-start; padding:8px 16px; } .sn-link { font-size:13px; padding:7px 12px; } }
  :global([data-sprungziel]) { scroll-margin-top:120px; }
</style>
<script>
  const nav = document.querySelector('.sn');
  if (nav) {
    const links = [...nav.querySelectorAll('.sn-link')];
    const ziele = links.map((l) => document.getElementById(l.dataset.ziel)).filter(Boolean);
    const kopf = document.querySelector('header');
    const setzeTop = () => { if (kopf) nav.style.top = kopf.offsetHeight + 'px'; };
    setzeTop(); addEventListener('resize', setzeTop);
    let letzte = null;
    const markiere = () => {
      const grenze = (kopf ? kopf.offsetHeight : 52) + nav.offsetHeight + 40;
      let akt = ziele[0];
      for (const z of ziele) if (z.getBoundingClientRect().top <= grenze) akt = z;
      if (!akt || akt.id === letzte) return;
      letzte = akt.id;
      links.forEach((l) => l.classList.toggle('aktiv', l.dataset.ziel === akt.id));
      const l = links.find((x) => x.dataset.ziel === akt.id);
      const innen = nav.firstElementChild;
      if (l && innen.scrollWidth > innen.clientWidth) innen.scrollTo({ left: l.offsetLeft - 16, behavior: 'smooth' });
    };
    addEventListener('scroll', markiere, { passive: true }); markiere();
  }
</script>
